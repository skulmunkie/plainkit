{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false, "cache": { "enabled": false } },
  "projects": {
    "team": {
      "projectType": "application",
      "root": "",
      "sourceRoot": ".",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "main.ts",
            "index": "index.html",
            "tsConfig": "tsconfig.json",
            "styles": ["../../shared/page.css"],
            "outputPath": { "base": "../../out/angular", "browser": "" },
            "aot": true,
            "optimization": true,
            "outputHashing": "all"
          }
        }
      }
    }
  }
}
