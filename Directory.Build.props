<Project>

  <!-- Shared build settings for every .NET project in this repository. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- NuGet package metadata (PlainKit.Blazor). The version is core/VERSION, the one version of the SDK and this package; a release PR changes it and the release workflow checks the tag names it. -->
  <PropertyGroup>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)core/VERSION').Trim())</Version>
    <Authors>Plainkit contributors</Authors>
    <Copyright>Copyright (c) 2026 Plainkit contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/skulmunkie/plainkit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/skulmunkie/plainkit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

</Project>
