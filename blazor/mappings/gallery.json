      "type": "PkGalleryKind",
      "existingEnum": true,
      "prop": "kind"
    },
    {
      "name": "Group",
      "prop": "group"
    },
    {
      "name": "Control",
      "prop": "control"
    },
    {
      "name": "Theme",
      "type": "PkTheme",
      "existingEnum": true,
      "prop": "theme"
    },
    {
      "name": "Width",
      "type": "PkWidth",
      "existingEnum": true,
      "prop": "width"
    },
    {
      "name": "Filter",
      "prop": "filter"
    },
    {
      "name": "Chrome",
      "type": "PkChrome",
      "existingEnum": true,
      "prop": "chrome"
    },
    {
      "name": "Height",
      "type": "int?",
      "prop": "height"
    },
    {
      "name": "Src",
      "type": "string?",
      "prop": "src",
      "default": "_content/PlainKit.Blazor/plainkit/gallery/embed.html"
    },
    {
      "name": "Sections",
      "type": "IReadOnlyList<PkGallerySection>?",
      "json": true,
      "prop": "sections",
      "note": "Sent as JSON text ([{ tag, title, open, lines, columns, rows, code }]); the gallery frame draws it in the Details drawer as text. PkGallerySection.ForBlazor() is the Blazor section, computed from the package's mappings."
