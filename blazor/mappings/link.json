{
  "component": "PkLink",
  "params": [
    {
      "name": "Href",
      "type": "string",
      "default": "",
      "map": "prop",
      "prop": "href"
    },
    {
      "name": "To",
      "type": "string",
      "map": "prop",
      "prop": "to"
    },
    {
      "name": "Navigate",
      "type": "string?",
      "map": "prop",
      "prop": "navigate",
      "extra": true,
      "note": "Who follows a To link on a plain click: \"router\" (default), \"host\" (OnNavigate is a notification and nothing navigates) or \"none\" (the browser follows the address)."
    },
    {
      "name": "Target",
      "type": "string",
      "map": "prop",
      "prop": "target"
    },
    {
      "name": "Rel",
      "type": "string",
      "map": "prop",
      "prop": "rel"
    },
    {
      "name": "Download",
      "type": "string",
      "map": "prop",
      "prop": "download"
    },
    {
      "name": "Current",
      "type": "bool",
      "default": false,
      "map": "prop",
      "prop": "current"
    },
    {
      "name": "Variant",
      "type": "LinkVariant",
      "default": "inline",
      "map": "prop",
      "prop": "variant"
    },
    {
      "name": "ChildContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": ""
    },
    {
      "name": "OnNavigate",
      "type": "EventCallback",
      "map": "event",
      "event": "pk-navigate",
      "cancelable": true
    },
    {
      "name": "OnClick",
      "event": "click",
      "type": "MouseEventArgs",
      "extra": true,
      "note": "Raised for every click, Href links included (#1747), without changing the navigation: ctrl, shift and middle clicks keep their native new-tab behaviour. Close a flyout or menu here. Attached only while bound, so an unbound link costs no round trip."
    }
  ],
  "listenedNative": true,
  "methods": [
    { "name": "FocusAsync", "method": "focus" }
  ]
}
