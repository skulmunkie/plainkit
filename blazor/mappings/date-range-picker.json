{
  "component": "PkDateRangePicker",
  "params": [
    {
      "name": "Start",
      "prop": "start",
      "type": "DateOnly?"
    },
    {
      "name": "Name",
      "prop": "name",
      "type": "string"
    },
    {
      "name": "Description",
      "prop": "description",
      "type": "string"
    },
    {
      "name": "Required",
      "prop": "required",
      "type": "bool"
    },
    {
      "name": "StartChanged",
      "event": "pk-range-change",
      "type": "EventCallback<DateOnly?>"
    },
    {
      "name": "End",
      "prop": "end",
      "type": "DateOnly?",
      "bind": {
        "event": "pk-range-change",
        "field": "end"
      }
    },
    {
      "name": "Min",
      "prop": "min",
      "type": "DateOnly?"
    },
    {
      "name": "Max",
      "prop": "max",
      "type": "DateOnly?"
    },
    {
      "name": "Presets",
      "prop": "presets",
      "type": "string",
      "note": "Built-in tokens: today, 7d, 30d, 90d, month, lastmonth, quarter, lastquarter, year, lastyear."
    },
    {
      "name": "PresetItems",
      "prop": "presetItems",
      "type": "IReadOnlyList<PkDatePreset>?",
      "json": true,
      "doc": "Your own named quick ranges (Key, Label, Start, End), shown after the Presets tokens; OnRangeChange reports the Key of the one the range equals as Preset."
    },
    {
      "name": "StartLabel",
      "prop": "startLabel",
      "type": "string"
    },
    {
      "name": "EndLabel",
      "prop": "endLabel",
      "type": "string"
    },
    {
      "name": "Calendar",
      "prop": "calendar",
      "type": "bool"
    },
    {
      "name": "Disabled",
      "prop": "disabled",
      "type": "bool"
    },
    {
      "name": "ReadOnly",
      "prop": "readonly",
      "type": "bool"
    },
    {
      "name": "IsInvalid",
      "prop": "invalid",
      "type": "bool"
    },
    {
      "name": "AriaLabel",
      "prop": "label",
      "type": "string"
    },
    {
      "name": "OnRangeChange",
      "event": "pk-range-change"
    },
    {
      "name": "OnInput",
      "event": "input",
      "type": "EventCallback<ChangeEventArgs>"
    },
    {
      "name": "OnChange",
      "event": "change",
      "type": "EventCallback<ChangeEventArgs>"
    }
  ],
  "model": {
    "prop": "start",
    "event": "pk-range-change",
    "key": "start",
    "type": "DateOnly?"
  },
  "notes": "Bind both ends with @bind-Start and @bind-End (each follows pk-range-change), and read Valid in OnRangeChange (args carry Start, End, Valid). Dates convert to and from ISO strings.",
  "methods": [
    { "name": "FocusAsync", "method": "focus" }
  ]
}
