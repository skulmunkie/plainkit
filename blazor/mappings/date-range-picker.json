{
  "component": "PkDateRangePicker",
  "params": [
    {
      "name": "Start",
      "prop": "start",
      "type": "DateOnly?"
    },
    {
      "name": "StartChanged",
      "event": "pk-range-change",
      "type": "EventCallback<DateOnly?>"
    },
    {
      "name": "End",
      "prop": "end",
      "type": "DateOnly?",
      "bind": {
        "event": "pk-range-change",
        "value": "detail.end"
      }
    },
    {
      "name": "Min",
      "prop": "min",
      "type": "DateOnly?"
    },
    {
      "name": "Max",
      "prop": "max",
      "type": "DateOnly?"
    },
    {
      "name": "Presets",
      "prop": "presets",
      "type": "string"
    },
    {
      "name": "StartLabel",
      "prop": "startLabel",
      "type": "string"
    },
    {
      "name": "EndLabel",
      "prop": "endLabel",
      "type": "string"
    },
    {
      "name": "Disabled",
      "prop": "disabled",
      "type": "bool"
    },
    {
      "name": "ReadOnly",
      "prop": "readonly",
      "type": "bool"
    },
    {
      "name": "IsInvalid",
      "prop": "invalid",
      "type": "bool"
    },
    {
      "name": "AriaLabel",
      "prop": "label",
      "type": "string"
    },
    {
      "name": "OnRangeChange",
      "event": "pk-range-change"
    }
  ],
  "model": {
    "prop": "start",
    "event": "pk-range-change",
    "key": "start",
    "type": "DateOnly?"
  },
  "notes": "Bind both ends with @bind-Start and @bind-End (each follows pk-range-change), and read Valid in OnRangeChange (args carry Start, End, Valid). Dates convert to and from ISO strings."
}
