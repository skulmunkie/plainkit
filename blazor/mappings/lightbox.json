{
  "component": "PkLightbox",
  "events": ["pk-open"],
  "params": [
    {
      "name": "Index",
      "type": "int",
      "default": 0,
      "map": "prop",
      "prop": "index",
      "bind": {"event":"pk-change","value":"detail.index"}
    },
    {
      "name": "Label",
      "type": "string",
      "default": "Image viewer",
      "map": "prop",
      "prop": "label"
    },
    {
      "name": "Items",
      "map": "property",
      "property": "items",
      "type": "IReadOnlyList<PkLightboxItem>",
      "doc": "The images to view: { src, alt, caption }. A property of the element (it has no attribute), set after the render."
    },
    {
      "name": "Open",
      "type": "bool",
      "default": false,
      "map": "prop",
      "prop": "open",
      "bind": {
        "event": "pk-close",
        "value": false
      }
    },
    {
      "name": "ChildContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": ""
    },
    {
      "name": "OnChange",
      "type": "EventCallback<LightboxChangeEventArgs>",
      "map": "event",
      "event": "pk-change",
      "cancelable": true
    },
    {
      "name": "OnClose",
      "type": "EventCallback<LightboxCloseEventArgs>",
      "map": "event",
      "event": "pk-close",
      "cancelable": true
    }
  ],
  "methods": [
    { "name": "ShowAsync", "method": "show", "args": [{ "name": "index", "type": "int" }] },
    { "name": "HideAsync", "method": "hide" }
  ]
}
