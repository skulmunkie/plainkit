{
  "component": "PkLightbox",
  "params": [
    {
      "name": "Index",
      "type": "int",
      "default": 0,
      "map": "prop",
      "prop": "index"
    },
    {
      "name": "Label",
      "type": "string",
      "default": "Image viewer",
      "map": "prop",
      "prop": "label"
    },
    {
      "name": "Open",
      "type": "bool",
      "default": false,
      "map": "prop",
      "prop": "open",
      "bind": {
        "event": "pk-close",
        "value": false
      }
    },
    {
      "name": "ChildContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": ""
    },
    {
      "name": "OnChange",
      "type": "EventCallback<LightboxChangeEventArgs>",
      "map": "event",
      "event": "pk-change",
      "cancelable": true
    },
    {
      "name": "OnClose",
      "type": "EventCallback<LightboxCloseEventArgs>",
      "map": "event",
      "event": "pk-close",
      "cancelable": true
    }
  ]
}
