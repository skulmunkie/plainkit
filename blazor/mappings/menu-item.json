{
  "component": "PkMenuItem",
  "params": [
    {
      "name": "Type",
      "type": "MenuitemType",
      "default": "item",
      "map": "prop",
      "prop": "type",
      "enum": {
        "Item": "item",
        "Checkbox": "checkbox",
        "Radio": "radio",
        "Header": "header",
        "Divider": "divider"
      }
    },
    {
      "name": "Checked",
      "type": "bool",
      "default": false,
      "map": "prop",
      "prop": "checked",
      "bind": {
        "event": "pk-select",
        "value": "detail.checked"
      }
    },
    {
      "name": "Disabled",
      "type": "bool",
      "default": false,
      "map": "prop",
      "prop": "disabled"
    },
    {
      "name": "Danger",
      "type": "bool",
      "default": false,
      "map": "prop",
      "prop": "danger"
    },
    {
      "name": "Value",
      "type": "string",
      "default": "",
      "map": "prop",
      "prop": "value"
    },
    {
      "name": "Href",
      "type": "string",
      "default": "",
      "map": "prop",
      "prop": "href"
    },
    {
      "name": "Open",
      "type": "bool",
      "default": false,
      "map": "prop",
      "prop": "open",
      "bind": {
        "event": "pk-submenu-toggle",
        "value": "detail.open"
      }
    },
    {
      "name": "Description",
      "type": "string",
      "default": "",
      "map": "prop",
      "prop": "description"
    },
    {
      "name": "ChildContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": ""
    },
    {
      "name": "PrefixContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": "prefix"
    },
    {
      "name": "SuffixContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": "suffix"
    },
    {
      "name": "DescriptionContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": "description"
    },
    {
      "name": "SubmenuContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": "submenu"
    },
    {
      "name": "OnSelect",
      "type": "EventCallback<MenuItemSelectEventArgs>",
      "map": "event",
      "event": "pk-select"
    }
  ]
}
