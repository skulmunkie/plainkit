{
  "component": "PkUnitInput",
  "params": [
    {
      "name": "Value",
      "type": "string",
      "default": "",
      "map": "prop",
      "prop": "value",
      "bind": {
        "event": "pk-value-change",
        "value": "detail.value"
      }
    },
    {
      "name": "Name",
      "type": "string",
      "default": "",
      "map": "prop",
      "prop": "name"
    },
    {
      "name": "Units",
      "type": "string",
      "default": "px,rem,em,%",
      "map": "prop",
      "prop": "units"
    },
    {
      "name": "Placeholder",
      "type": "string",
      "default": "",
      "map": "prop",
      "prop": "placeholder"
    },
    {
      "name": "AriaLabel",
      "type": "string",
      "default": "",
      "map": "prop",
      "prop": "label"
    },
    {
