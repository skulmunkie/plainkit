      "type": "bool",
      "default": false,
      "map": "prop",
      "prop": "showLabel"
    },
    {
      "name": "Disabled",
      "type": "bool",
      "default": false,
      "map": "prop",
      "prop": "disabled"
    },
    {
      "name": "ReadOnly",
      "type": "bool",
      "default": false,
      "map": "prop",
      "prop": "readonly"
    },
    {
      "name": "Required",
      "type": "bool",
      "default": false,
      "map": "prop",
      "prop": "required"
    },
    {
      "name": "IsInvalid",
      "type": "bool",
      "default": false,
      "map": "prop",
      "prop": "invalid"
    },
    {
      "name": "Min",
      "type": "string",
      "default": "",
      "map": "prop",
      "prop": "min"
    },
    {
      "name": "Max",
      "type": "string",
      "default": "",
      "map": "prop",
      "prop": "max"
    },
    {
      "name": "Step",
      "type": "string",
      "default": "any",
      "map": "prop",
      "prop": "step"
