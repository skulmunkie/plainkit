{
  "component": "PkCommandPalette",
  "params": [
    {
      "name": "Open",
      "type": "bool",
      "default": false,
      "map": "prop",
      "prop": "open",
      "bind": [
        {
          "event": "pk-open",
          "value": true
        },
        {
          "event": "pk-close",
          "value": false
        }
      ]
    },
    {
      "name": "Placeholder",
      "type": "string",
      "default": "Type a command or search…",
      "map": "prop",
      "prop": "placeholder"
    },
    {
      "name": "RecentsKey",
      "type": "string",
      "default": "pk-palette-recents",
      "map": "prop",
      "prop": "recentsKey"
    },
    {
      "name": "NoShortcut",
      "type": "bool",
      "default": false,
      "map": "prop",
      "prop": "noShortcut"
    },
    {
      "name": "Label",
      "type": "string",
      "default": "Command palette",
      "map": "prop",
      "prop": "label"
    },
    {
      "name": "Items",
      "map": "property",
      "property": "items",
      "type": "IReadOnlyList<PkCommandPaletteItem>",
      "doc": "The commands the palette lists and searches: { id, label, group?, hint?, keywords?, href?, shortcut? }. A property of the element (it has no attribute), set after the render; OnSelect reports the chosen Id."
    },
    {
      "name": "OnOpen",
      "event": "pk-open"
    },
    {
      "name": "OnClose",
      "event": "pk-close"
    },
    {
      "name": "OnSelect",
      "type": "EventCallback<PkSelectEventArgs>",
      "map": "event",
      "event": "pk-select"
    }
  ],
  "methods": [
    { "name": "ShowAsync", "method": "show" },
    { "name": "HideAsync", "method": "hide" }
  ]
}
