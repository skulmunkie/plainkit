{
  "component": "PkSplitButton",
  "params": [
    { "name": "Type", "prop": "type", "type": "SplitButtonType" },
    {
      "name": "Variant",
      "prop": "variant",
      "type": "string"
    },
    {
      "name": "Disabled",
      "prop": "disabled",
      "type": "bool"
    },
    {
      "name": "ToggleLabel",
      "prop": "toggleLabel",
      "type": "string"
    },
    {
      "name": "Open",
      "prop": "open",
      "bind": {"event":"pk-menu-toggle","value":"detail.open"},
      "type": "bool"
    },
    {
      "name": "MenuAlign",
      "prop": "menuAlign",
      "type": "string"
    },
    {
      "name": "OnClick",
      "event": "click",
      "type": "MouseEventArgs"
    },
    {
      "name": "OnSelect",
      "event": "pk-split-select",
      "type": "{ value: string, label: string }"
    },
    {
      "name": "ChildContent",
      "slot": "",
      "type": "RenderFragment"
    },
    {
      "name": "MenuContent",
      "slot": "menu",
      "type": "RenderFragment"
    }
  ],
  "events": ["pk-menu-toggle"],
  "methods": [
    { "name": "ShowAsync", "method": "show" },
    { "name": "HideAsync", "method": "hide" }
  ]
}
