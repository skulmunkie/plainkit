{
  "component": "PkSideNav",
  "existing": true,
  "notes": "Hand-written (issue 210): CurrentPath is an explicit override; unset, the component tracks NavigationManager itself instead of the host wiring LocationChanged by hand.",
  "params": [
    {
      "name": "Label",
      "type": "string",
      "map": "prop",
      "prop": "label"
    },
    {
      "name": "Collapsed",
      "type": "bool",
      "map": "prop",
      "prop": "collapsed",
      "bind": {
        "event": "pk-nav-toggle",
        "value": "detail.collapsed"
      }
    },
    {
      "name": "Open",
      "type": "bool",
      "map": "prop",
      "prop": "open",
      "bind": {
        "event": "pk-close",
        "value": false
      }
    },
    {
      "name": "Filterable",
      "type": "bool",
      "map": "prop",
      "prop": "filterable"
    },
    {
      "name": "Persist",
      "type": "string?",
      "map": "prop",
      "prop": "persist"
    },
    {
      "name": "CurrentPath",
      "type": "string?",
      "map": "prop",
      "prop": "currentPath"
    },
    {
      "name": "AutoExpandActive",
      "type": "bool",
      "map": "prop",
      "prop": "autoExpandActive"
    },
    {
      "name": "BrandContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": "brand"
    },
    {
      "name": "ChildContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": ""
    },
    {
      "name": "FooterContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": "footer"
    },
    {
      "name": "OnToggle",
      "type": "EventCallback<bool>",
      "map": "event",
      "event": "pk-nav-toggle"
    }
  ]
}
