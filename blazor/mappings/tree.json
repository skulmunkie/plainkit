{
  "component": "PkTree",
  "params": [
    {
      "name": "Label",
      "prop": "label",
      "type": "string"
    },
    {
      "name": "Selection",
      "prop": "selection",
      "type": "TreeSelection"
    },
    {
      "name": "Value",
      "prop": "value",
      "type": "string"
    },
    {
      "name": "ValueChanged",
      "event": "pk-select",
      "type": "EventCallback<string>"
    },
    {
      "name": "Navigate",
      "prop": "navigate",
      "type": "string?",
      "extra": true,
      "note": "Who follows an Href on a plain click: \"router\" (default), \"host\" (OnNavigate is a notification and nothing navigates, so your handler uses NavigationManager) or \"none\" (the browser follows the address). It is the default for the items with an Href that set none."
    },
    {
      "name": "OnToggle",
      "event": "pk-toggle",
      "type": "EventCallback<PkToggleEventArgs>"
    },
    {
      "name": "ChildContent",
      "slot": "",
      "type": "RenderFragment"
    }
  ],
  "notes": "Bind with @bind-Value."
}
