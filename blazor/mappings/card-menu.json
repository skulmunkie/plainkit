{
  "component": "PkCardMenu",
  "params": [
    {
      "name": "Label",
      "type": "string",
      "default": "Card actions",
      "map": "prop",
      "prop": "label"
    },
    {
      "name": "IconName",
      "type": "string",
      "default": "more",
      "map": "prop",
      "prop": "iconName"
    },
    {
      "name": "Placement",
      "type": "string",
      "default": "bottom-end",
      "map": "prop",
      "prop": "placement"
    },
    {
      "name": "Open",
      "type": "bool",
      "default": false,
      "map": "prop",
      "prop": "open",
      "bind": {
        "event": "pk-close",
        "value": false
      }
    },
    {
      "name": "ChildContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": ""
    },
    {
      "name": "OnSelect",
      "type": "EventCallback<PkSelectEventArgs>",
      "map": "event",
      "event": "pk-select"
    },
    {
      "name": "OnOpen",
      "type": "EventCallback",
      "map": "event",
      "event": "pk-open"
    },
    {
      "name": "OnClose",
      "type": "EventCallback<PkCloseEventArgs>",
      "map": "event",
      "event": "pk-close",
      "cancelable": true
    }
  ]
}
