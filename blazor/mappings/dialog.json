{
  "component": "PkDialog",
  "params": [
    {
      "name": "IsOpen",
      "type": "bool",
      "map": "prop",
      "prop": "open",
      "bind": {
        "event": "pk-close",
        "value": false
      }
    },
    {
      "name": "Title",
      "type": "string?",
      "map": "prop",
      "prop": "heading"
    },
    {
      "name": "HeaderContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": "header"
    },
    {
      "name": "ChildContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": ""
    },
    {
      "name": "FooterContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": "footer"
    },
    {
      "name": "OnClose",
      "type": "EventCallback",
      "map": "event",
      "event": "pk-close",
      "cancelable": true
    },
    {
      "name": "ShowCloseButton",
      "type": "bool",
      "default": true,
      "prop": "hideClose",
      "invert": true,
      "note": "False hides the header close button (the opposite of hideClose); give the dialog its own Cancel or Close."
    },
    {
      "name": "CloseButtonLabel",
      "type": "string",
      "map": "wrapper",
      "note": "The element has no prop for the close button text; it draws a cross with a fixed accessible name (hideClose, mapped as ShowCloseButton, removes it)."
    },
    {
      "name": "FooterAlignEnd",
      "type": "bool",
      "map": "wrapper",
      "note": "The footer is always end-aligned; there is nothing to switch."
    },
    {
      "name": "Size",
      "type": "PkDialogSize",
      "map": "prop",
      "prop": "size"
    },
    {
      "name": "MaxWidthPx",
      "type": "int",
      "map": "prop",
      "prop": "maxWidth"
    },
    {
      "name": "OverFlyout",
      "type": "bool",
      "map": "wrapper",
      "note": "Not needed: a native dialog is in the top layer, above any flyout."
    },
    {
      "name": "Tint",
      "type": "PkDialogTint",
      "map": "prop",
      "prop": "tint",
      "enum": {
        "None": "none",
        "Product": "product",
        "Archived": "archived"
      },
      "default": "None"
    }
  ]
}
