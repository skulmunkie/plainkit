{
  "component": "PkDialog",
  "params": [
    {
      "name": "IsOpen",
      "type": "bool",
      "map": "prop",
      "prop": "open",
      "bind": {
        "event": "pk-close",
        "value": false
      }
    },
    {
      "name": "Title",
      "type": "string?",
      "map": "prop",
      "prop": "heading"
    },
    {
      "name": "HeaderContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": "header"
    },
    {
      "name": "ChildContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": ""
    },
    {
      "name": "FooterContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": "footer"
    },
    {
      "name": "OnClose",
      "type": "EventCallback",
      "map": "event",
      "event": "pk-close",
      "cancelable": true
    },
    {
      "name": "ShowCloseButton",
      "type": "bool",
      "map": "wrapper",
      "note": "The element always shows its close button (house rule: every modal has its own Cancel or Close)."
    },
    {
      "name": "CloseButtonLabel",
      "type": "string",
      "map": "wrapper",
      "note": "Text of the close button; the element draws a cross with an accessible name."
    },
    {
      "name": "FooterAlignEnd",
      "type": "bool",
      "map": "wrapper",
      "note": "The footer is always end-aligned."
    },
    {
      "name": "MaxWidthPx",
      "type": "int",
      "map": "prop",
      "prop": "maxWidth"
    },
    {
      "name": "OverFlyout",
      "type": "bool",
      "map": "wrapper",
      "note": "Not needed: a native dialog is in the top layer above any flyout."
    },
    {
      "name": "Tint",
      "type": "PkDialogTint",
      "map": "prop",
      "prop": "tint",
      "enum": {
        "None": "none",
        "Product": "product",
        "Archived": "archived"
      },
      "default": "None"
    }
  ]
}
