{
  "component": "PkCombobox",
  "params": [
    {
      "name": "Value",
      "prop": "value",
      "type": "string"
    },
    {
      "name": "Placeholder",
      "prop": "placeholder",
      "type": "string"
    },
    {
      "name": "Disabled",
      "prop": "disabled",
      "type": "bool"
    },
    {
      "name": "Required",
      "prop": "required",
      "type": "bool"
    },
    {
      "name": "IsInvalid",
      "prop": "invalid",
      "type": "bool"
    },
    {
      "name": "Mode",
      "prop": "mode",
      "type": "ComboboxMode"
    },
    {
      "name": "Free",
      "prop": "free",
      "type": "bool"
    },
    {
      "name": "Clearable",
      "prop": "clearable",
      "type": "bool"
    },
    {
      "name": "Filtering",
      "prop": "filtering",
      "type": "ComboboxFiltering"
    },
    {
      "name": "DebounceMs",
      "prop": "debounce",
      "type": "int"
    },
    {
      "name": "Open",
      "prop": "open",
      "type": "bool",
      "bind": {
        "event": "pk-combo-toggle",
        "value": "detail.open"
      }
    },
    {
      "name": "AriaLabel",
      "prop": "label",
      "type": "string"
    },
    {
      "name": "Name",
      "prop": "name",
      "type": "string"
    },
    {
      "name": "Description",
      "prop": "description",
      "type": "string"
    },
    {
      "name": "OnSearchInput",
      "event": "pk-combo-query",
      "type": "{ query: string }"
    },
    {
      "name": "OnSearch",
      "callback": "search",
      "type": "Func<string, CancellationToken, Task<IReadOnlyList<PkFieldOption>>>?",
      "arg": "string",
      "args": "a",
      "abort": true,
      "returns": "r.Select(o => new { value = o.Value, label = o.Label }).ToArray()",
      "doc": "Answers the typed text with the options to list (the answer replaces the list, and the built-in filter is off while it is set). A query a newer one replaces, or the component going away, cancels its CancellationToken and the late answer is dropped by the element. Use it instead of OnSearchInput plus re-rendering the options when the search should be cancellable."
    },
    {
      "name": "OnInput",
      "event": "input",
      "type": "EventCallback<ChangeEventArgs>"
    },
    {
      "name": "OnChange",
      "event": "change",
      "type": "EventCallback<ChangeEventArgs>"
    },
    {
      "name": "ChildContent",
      "slot": "",
      "type": "RenderFragment"
    },
    {
      "name": "EmptyContent",
      "slot": "empty",
      "type": "RenderFragment"
    },
    {
      "name": "OnToggle",
      "event": "pk-combo-toggle"
    }
  ],
  "model": {
    "prop": "value",
    "event": "pk-combo-select",
    "key": "value",
    "type": "string",
    "field": true
  },
  "methods": [
    { "name": "FocusAsync", "method": "focus" },
    { "name": "ShowAsync", "method": "show" },
    { "name": "HideAsync", "method": "hide" }
  ]
}
