{
  "component": "PkAppShell",
  "params": [
    {
      "name": "SidebarContent",
      "type": "RenderFragment",
      "map": "slot",
      "slot": "nav"
    },
    {
      "name": "HeaderContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": "header"
    },
    {
      "name": "TitleContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": "title"
    },
    {
      "name": "BackHref",
      "type": "string",
      "default": "",
      "map": "prop",
      "prop": "backHref"
    },
    {
      "name": "BackLabel",
      "type": "string",
      "default": "Back",
      "map": "prop",
      "prop": "backLabel"
    },
    {
      "name": "BodyContent",
      "type": "RenderFragment",
      "map": "slot",
      "slot": ""
    },
    {
      "name": "FooterContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": "footer"
    },
    {
      "name": "ShowErrorOverlay",
      "type": "bool",
      "default": true,
      "map": "wrapper",
      "note": "The framework error bar (#blazor-error-ui) belongs to the host page and its layout CSS, and pk-app-shell has no such feature; keep it in your layout."
    },
    {
      "name": "ErrorOverlayMessage",
      "type": "string",
      "map": "wrapper",
      "note": "As ShowErrorOverlay."
    },
    {
      "name": "NavOpen",
      "type": "bool",
      "map": "prop",
      "prop": "navOpen",
      "bind": {
        "event": "pk-nav-toggle",
        "value": "detail.open"
      }
    },
    {
      "name": "NavHidden",
      "type": "bool",
      "map": "prop",
      "prop": "navHidden",
      "bind": {
        "event": "pk-nav-toggle",
        "value": "detail.hidden"
      }
    },
    {
      "name": "Flush",
      "prop": "flush",
      "type": "bool"
    }
  ]
}
