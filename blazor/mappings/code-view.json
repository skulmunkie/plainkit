{
  "component": "PkCodeView",
  "params": [
    {
      "name": "Lines",
      "type": "IReadOnlyList<string>?",
      "map": "prop",
      "prop": "lines"
    },
    {
      "name": "Segments",
      "map": "property",
      "property": "segments",
      "type": "IReadOnlyList<IReadOnlyList<PkCodeSegment>>",
      "doc": "Optional colouring: one list of runs per line of Lines, each { text, kind, match, word }. The runs of a line should join to the line's text."
    },
    {
      "name": "Start",
      "prop": "start",
      "type": "int",
      "default": 1
    },
    {
      "name": "Highlight",
      "prop": "highlight",
      "type": "string"
    },
    {
      "name": "Label",
      "prop": "label",
      "type": "string",
      "default": "Code"
    },
    {
      "name": "MaxHeight",
      "prop": "maxHeight",
      "type": "string"
    },
    {
      "name": "OnLineClick",
      "event": "pk-line-click"
    },
    {
      "name": "ChildContent",
      "text": "",
      "type": "string"
    }
  ],
  "notes": "Pass the code as Lines, or as ChildContent text. The per-line colouring is the Segments parameter (a property, set after the render)."
}
