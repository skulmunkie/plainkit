{
  "component": "PkTooltip",
  "params": [
    {
      "name": "Text",
      "type": "string?",
      "map": "prop",
      "prop": "text"
    },
    {
      "name": "TooltipContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": "content"
    },
    {
      "name": "ChildContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": ""
    },
    {
      "name": "Placement",
      "type": "PkTooltipPlacement",
      "enum": {
        "Top": "top",
        "Bottom": "bottom",
        "Left": "left",
        "Right": "right"
      },
      "default": "Top",
      "map": "prop",
      "prop": "placement"
    },
    {
      "name": "HoverDelay",
      "type": "int",
      "default": 200,
      "map": "prop",
      "prop": "delay"
    },
    {
      "name": "Help",
      "type": "bool",
      "map": "prop",
      "prop": "help"
    },
    {
      "name": "Enrich",
      "type": "bool",
      "map": "prop",
      "prop": "enrich"
    },
    {
      "name": "Title",
      "type": "string?",
      "map": "prop",
      "prop": "heading"
    },
    {
      "name": "DocLink",
      "type": "string?",
      "map": "wrapper",
      "note": "Link inside the rich content slot."
    },
    {
      "name": "ExternalLink",
      "type": "string?",
      "map": "wrapper",
      "note": "As DocLink."
    },
    {
      "name": "LoadAsync",
      "type": "Func<CancellationToken, Task<RenderFragment?>>?",
      "map": "wrapper",
      "note": "Loads the rich slot content on the first pk-show."
    },
    {
      "name": "OnClick",
      "type": "EventCallback",
      "map": "wrapper",
      "note": "Click on the target."
    }
  ]
}
