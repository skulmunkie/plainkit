{
  "component": "PkTooltip",
  "events": ["pk-show", "pk-hide"],
  "params": [
    {
      "name": "Text",
      "type": "string?",
      "map": "prop",
      "prop": "text"
    },
    {
      "name": "Label",
      "type": "string?",
      "map": "prop",
      "prop": "label"
    },
    {
      "name": "TooltipContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": "content"
    },
    {
      "name": "LinksContent",
      "slot": "links",
      "type": "RenderFragment?"
    },
    {
      "name": "ChildContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": ""
    },
    {
      "name": "Placement",
      "type": "PkTooltipPlacement",
      "enum": {
        "Top": "top",
        "Bottom": "bottom",
        "Left": "left",
        "Right": "right"
      },
      "default": "Top",
      "map": "prop",
      "prop": "placement"
    },
    {
      "name": "HoverDelay",
      "type": "int",
      "default": 200,
      "map": "prop",
      "prop": "delay"
    },
    {
      "name": "Help",
      "type": "bool",
      "map": "prop",
      "prop": "help"
    },
    {
      "name": "Enrich",
      "type": "bool",
      "map": "prop",
      "prop": "enrich"
    },
    {
      "name": "Title",
      "type": "string?",
      "map": "prop",
      "prop": "heading"
    },
    {
      "name": "DocLink",
      "type": "string?",
      "map": "wrapper",
      "note": "The element has no link props: links are your own anchors in the links slot (LinksContent), where you choose the text and target."
    },
    {
      "name": "ExternalLink",
      "type": "string?",
      "map": "wrapper",
      "note": "As DocLink."
    },
    {
      "name": "LoadAsync",
      "type": "Func<CancellationToken, Task<RenderFragment?>>?",
      "map": "wrapper",
      "note": "Re-decided after the lifecycle events (#1380): stays out. Needs component state and an async load run on the first pk-show, and a hand-written component would break the thin wrapper. Use OnShow (the pk-show event) to start your own load, and set the content from your handler."
    },
    {
      "name": "OnClick",
      "type": "EventCallback",
      "map": "wrapper",
      "note": "The element has no click event; put a click handler on the element you wrap."
    }
  ],
  "methods": [
    { "name": "ShowAsync", "method": "show" },
    { "name": "HideAsync", "method": "hide" }
  ]
}
