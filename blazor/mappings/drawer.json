{
  "component": "PkDrawer",
  "params": [
    {
      "name": "IsOpen",
      "type": "bool",
      "map": "prop",
      "prop": "open",
      "bind": {
        "event": "pk-close",
        "value": false
      }
    },
    {
      "name": "Title",
      "type": "string?",
      "map": "prop",
      "prop": "heading"
    },
    {
      "name": "ChildContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": ""
    },
    {
      "name": "FooterContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": "footer"
    },
    {
      "name": "ActionsContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": "actions"
    },
    {
      "name": "OnClose",
      "type": "EventCallback",
      "map": "event",
      "event": "pk-close",
      "cancelable": true
    },
    {
      "name": "Persistent",
      "type": "bool",
      "default": false,
      "map": "prop",
      "prop": "persistent"
    },
    {
      "name": "Wide",
      "type": "bool",
      "map": "prop",
      "prop": "wide"
    },
    {
      "name": "Backdrop",
      "type": "bool",
      "default": true,
      "map": "wrapper",
      "note": "The element has no backdrop switch; the backdrop-less inspector is the docked prop, which is the Docked parameter."
    },
    {
      "name": "IsLoading",
      "type": "bool",
      "map": "wrapper",
      "note": "The element has no loading state. Wrapping the body in pk-loading-overlay from the component would change the shape of the markup when it toggles and remount the body; wrap ChildContent in PkLoadingOverlay yourself."
    },
    {
      "name": "PhoneCards",
      "type": "bool",
      "default": true,
      "map": "wrapper",
      "note": "The SDK has no phone card layout for a drawer."
    },
    {
      "name": "Docked",
      "type": "bool",
      "map": "prop",
      "prop": "docked"
    }
  ]
}
