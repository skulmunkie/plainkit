{
  "component": "PkTreeItem",
  "params": [
    {
      "name": "Label",
      "prop": "label",
      "type": "string"
    },
    {
      "name": "Value",
      "prop": "value",
      "type": "string"
    },
    {
      "name": "Expanded",
      "prop": "expanded",
      "bind": {"event":"pk-toggle","value":"detail.expanded"},
      "type": "bool"
    },
    {
      "name": "Selected",
      "prop": "selected",
      "bind": [{"event":"pk-select","value":true}],
      "type": "bool"
    },
    {
      "name": "Href",
      "prop": "href",
      "type": "string"
    },
    {
      "name": "Disabled",
      "prop": "disabled",
      "type": "bool"
    },
    {
      "name": "Expandable",
      "prop": "expandable",
      "type": "bool"
    },
    {
      "name": "ChildContent",
      "slot": "",
      "type": "RenderFragment"
    },
    {
      "name": "LabelContent",
      "slot": "label",
      "type": "RenderFragment"
    },
    {
      "name": "IconContent",
      "slot": "icon",
      "type": "RenderFragment"
    },
    {
      "name": "OnSelect",
      "event": "pk-select",
      "type": "EventCallback<PkSelectEventArgs>"
    },
    {
      "name": "OnNavigate",
      "event": "pk-navigate",
      "type": "EventCallback",
      "cancelable": true
    },
    {
      "name": "OnToggle",
      "event": "pk-toggle",
      "type": "EventCallback<PkToggleEventArgs>"
    }
  ]
}
