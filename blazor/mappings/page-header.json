{
  "component": "PkPageHeader",
  "params": [
    {
      "name": "Title",
      "prop": "heading",
      "type": "string",
      "slotted": {
        "tag": "pk-heading",
        "slot": "title",
        "attrs": {
          "level": "@PkAttr.Num(Level)",
          "weight": "semibold",
          "variant": "h3",
          "tabindex": "-1",
          "truncate": "@(Variant == PageHeaderVariant.Record)",
          "title": "@(Variant == PageHeaderVariant.Record ? Title : null)"
        }
      }
    },
    {
      "name": "Level",
      "prop": "level",
      "type": "int",
      "default": 1
    },
    {
      "name": "Variant",
      "prop": "variant",
      "type": "PageHeaderVariant"
    },
    {
      "name": "Sticky",
      "prop": "sticky",
      "type": "bool"
    },
    {
      "name": "StickyFrom",
      "type": "PageHeaderStickyFrom",
      "prop": "stickyFrom"
    },
    {
      "name": "Spacious",
      "prop": "spacious",
      "type": "bool"
    },
    {
      "name": "SuffixContent",
      "slot": "",
      "type": "RenderFragment?"
    },
    {
      "name": "BreadcrumbContent",
      "slot": "breadcrumb",
      "type": "RenderFragment?",
      "unless": "Crumbs"
    },
    {
      "name": "ActionsContent",
      "slot": "actions",
      "type": "RenderFragment?"
    },
    {
      "name": "MetaContent",
      "slot": "meta",
      "type": "RenderFragment?"
    },
    {
      "name": "ActionsOverflow",
      "type": "PageHeaderActionsOverflow",
      "prop": "actionsOverflow"
    },
    {
      "name": "OverflowLabel",
      "prop": "overflowLabel",
      "type": "string"
    },
    {
      "name": "TabsFrom",
      "type": "PageHeaderTabsFrom",
      "prop": "tabsFrom"
    },
    {
      "name": "TabItems",
      "prop": "tabs",
      "type": "IReadOnlyList<PkRecordTab>"
    },
    {
      "name": "OnTabChange",
      "event": "pk-tab-change"
    },
    {
      "name": "TabsContent",
      "slot": "tabs",
      "type": "RenderFragment?"
    },
    {
      "name": "HomeHref",
      "type": "string",
      "prop": "homeHref"
    },
    {
      "name": "HomeLabel",
      "type": "string",
      "prop": "homeLabel"
    },
    {
      "name": "HomeIcon",
      "type": "string",
      "prop": "homeIcon"
    },
    {
      "name": "Crumbs",
      "prop": "crumbs",
      "type": "IReadOnlyList<PkCrumb>?",
      "note": "Typed list of PkCrumb: sent as the element's crumbs attribute (a JSON array of { label, href }); the element draws the breadcrumb, home crumb and back link (#801). BreadcrumbContent is for a trail you draw yourself, without Crumbs.",
      "json": true
    },
    {
      "name": "BreadcrumbLabel",
      "type": "string",
      "prop": "breadcrumbLabel"
    },
    {
      "name": "BackLink",
      "type": "bool",
      "prop": "backLink"
    }
  ],
  "notes": "Generated. Title maps to heading and is also drawn as a slotted pk-heading in the title slot (level from Level, tabindex -1, like the JS page shell, #773: the generator's slotted option; on a record it truncates to one line with the full Title as its tooltip, #1761); SuffixContent is the default slot (beside the title). The trail, home crumb and back link are the element's (crumbs, homeHref, backLink)."
}
