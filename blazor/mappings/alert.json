{
  "component": "PkAlert",
  "params": [
    {
      "name": "Kind",
      "type": "PkAlertKind",
      "enum": {
        "Error": "danger",
        "Warning": "warning",
        "Info": "info",
        "Success": "success"
      },
      "default": "Error",
      "map": "prop",
      "prop": "kind"
    },
    {
      "name": "Title",
      "type": "string?",
      "map": "prop",
      "prop": "heading"
    },
    {
      "name": "Message",
      "type": "string?",
      "map": "slot",
      "slot": ""
    },
    {
      "name": "ChildContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": ""
    },
    {
      "name": "Dismissible",
      "type": "bool",
      "map": "prop",
      "prop": "dismissible"
    },
    {
      "name": "OnDismiss",
      "type": "EventCallback",
      "map": "event",
      "event": "pk-dismiss",
      "cancelable": true
    },
    {
      "name": "Boxed",
      "type": "bool",
      "map": "wrapper",
      "note": "The alert element is always boxed; it has no unboxed variant."
    },
    {
      "name": "Inline",
      "type": "bool",
      "map": "wrapper",
      "note": "Alert is a block; it has no inline variant."
    },
    {
      "name": "Compact",
      "type": "bool",
      "map": "wrapper",
      "note": "Compat class only."
    },
    {
      "name": "ExtraClass",
      "type": "string",
      "map": "wrapper",
      "note": "Passed to the host element class attribute."
    },
    {
      "name": "AdditionalAttributes",
      "type": "Dictionary<string, object>?",
      "map": "wrapper",
      "note": "Splatted onto the host element."
    }
  ]
}
