{
  "component": "PkAlert",
  "params": [
    {
      "name": "Kind",
      "type": "PkAlertKind",
      "enum": {
        "Error": "danger",
        "Warning": "warning",
        "Info": "info",
        "Success": "success"
      },
      "default": "Error",
      "map": "prop",
      "prop": "kind"
    },
    {
      "name": "Title",
      "type": "string?",
      "map": "prop",
      "prop": "heading"
    },
    {
      "name": "Message",
      "type": "string?",
      "map": "slot",
      "slot": ""
    },
    {
      "name": "ChildContent",
      "type": "RenderFragment?",
      "map": "slot",
      "slot": ""
    },
    {
      "name": "Dismissible",
      "type": "bool",
      "map": "prop",
      "prop": "dismissible"
    },
    {
      "name": "OnDismiss",
      "type": "EventCallback",
      "map": "event",
      "event": "pk-dismiss",
      "cancelable": true
    },
    {
      "name": "Boxed",
      "type": "bool",
      "default": true,
      "prop": "plain",
      "invert": true,
      "note": "False is the plain form (coloured text, no box); the parameter is the opposite of the plain prop."
    },
    {
      "name": "Inline",
      "type": "bool",
      "prop": "inline"
    },
    {
      "name": "Compact",
      "type": "bool",
      "prop": "compact"
    },
    {
      "name": "ExtraClass",
      "type": "string",
      "map": "wrapper",
      "note": "Passed to the host element class attribute."
    },
    {
      "name": "AdditionalAttributes",
      "type": "Dictionary<string, object>?",
      "map": "wrapper",
      "note": "Splatted onto the host element."
    }
  ]
}
