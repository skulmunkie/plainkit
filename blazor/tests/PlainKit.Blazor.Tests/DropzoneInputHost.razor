@using Microsoft.AspNetCore.Components.Forms
@* The documented PkDropzone + InputFile usage (issue #83): the InputFile carries slot="input" and is a direct child of pk-dropzone. *@
<PkDropzone Label="Files" Multiple="true">
    <ChildContent>
        <InputFile slot="input" multiple OnChange="OnChange" />
        Drop files here
    </ChildContent>
</PkDropzone>

@code {
    public List<string> Read { get; } = new();

    private async Task OnChange(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(5))
        {
            using var reader = new StreamReader(file.OpenReadStream(1024));
            Read.Add(file.Name + ":" + await reader.ReadToEndAsync());
        }
    }
}
