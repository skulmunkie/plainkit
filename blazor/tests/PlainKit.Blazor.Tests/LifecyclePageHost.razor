@* A concrete PageBase (issue 1022) that records its loads so the tests can drive OnLoadAsync, LoadCancellation and dispose. *@
@inherits PageBase

<p>@(IsLoading ? "loading" : LoadError is not null ? "error:" + LoadError.Message : "ready")</p>

@code {
    [Parameter] public int Key { get; set; }
    [Parameter] public Func<CancellationToken, Task>? Load { get; set; }
    public int Loads { get; private set; }
    public List<CancellationToken> Tokens { get; } = [];
    public bool Disposed => LoadCancellation.IsCancellationRequested;
    public Task CallInvokeStateChanged() => InvokeStateChanged();

    protected override async Task OnLoadAsync(CancellationToken cancel)
    {
        Loads++;
        Tokens.Add(cancel);
        if (Load is not null) await Load(cancel);
    }
}
