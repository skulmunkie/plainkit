@* A PkComponentBase that turns parameter reloads off (issue 1776): it must still load once. *@
@inherits PkComponentBase

<p>@(Loads > 0 ? "loaded" : "empty")</p>

@code {
    [Parameter] public int Key { get; set; }
    public int Loads { get; private set; }
    protected override bool ReloadOnParameters => false;
    protected override Task OnLoadAsync(CancellationToken cancel) { Loads++; return Task.CompletedTask; }
}
