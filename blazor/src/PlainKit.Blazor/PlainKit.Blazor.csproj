<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>PlainKit.Blazor</RootNamespace>
    <PackageId>PlainKit.Blazor</PackageId>
    <Description>Blazor components over Plainkit, the dependency-free HTML/CSS/JS toolkit. Ships the toolkit and its gallery, code explorer and scorecard as static web assets.</Description>
    <PackageTags>blazor;razor-components;design-system;web-components;plainkit</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PlainKit.Blazor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" PrivateAssets="all" />
  </ItemGroup>

  <!-- Generated/ (the Pk* components) and wwwroot/plainkit (a copy of core/dist) are NOT in git: node scripts/bootstrap.mjs writes them. Without them the
       project does not compile (the components do not exist) or embeds nothing, with errors far from the cause, so it stops here with one instruction. -->
  <Target Name="PkRequireGeneratedFiles" BeforeTargets="BeforeBuild;CoreCompile;ResolveStaticWebAssetsInputs;PrepareResourceNames">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/Generated/generated.manifest.json') Or !Exists('$(MSBuildProjectDirectory)/wwwroot/plainkit/manifest.json')"
           Text="Generated files are missing: run node scripts/bootstrap.mjs from the repository root" />
  </Target>

  <!-- wwwroot/plainkit is a byte-for-byte copy of core/dist (node scripts/publish-dist.mjs, part of node scripts/bootstrap.mjs; not in git). It is served under
       _content/PlainKit.Blazor/plainkit/. Files outside wwwroot cannot be served by the static web assets runtime, hence the copy. -->

  <!-- Generated/generated.manifest.json is a review aid for the generator (the generator's check compares it), not something consumers need (also not in git). The SDK treats
       *.json as Content, which packs it under content/ and contentFiles/ and copies it into a consumer's project, so it is taken out of the package.
       scripts/tests/blazor-package.test.mjs checks this. -->
  <ItemGroup>
    <Content Remove="Generated\generated.manifest.json" />
    <None Include="Generated\generated.manifest.json" Pack="false" />
  </ItemGroup>

  <!-- The element mappings and the generator's manifest travel inside the assembly (not as content or static assets): PkMappingInfo reads them to
       describe a component in the dev tools' inspector. The mappings belong to this package; the SDK never holds a copy. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\mappings\*.json" LogicalName="plainkit-mappings/%(Filename)%(Extension)" Visible="false" />
    <EmbeddedResource Include="Generated\generated.manifest.json" LogicalName="plainkit-mappings/generated.manifest.json" Visible="false" />
  </ItemGroup>

  <!-- The toolkit's file list with each file's SHA-384 travels inside the assembly too: PkAssets.Versioned builds a content-hash cache-busting
       URL from it without touching the disk. It is a copy of the served manifest, so it is always the hash of the files this package serves. -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\plainkit\manifest.json" LogicalName="plainkit-assets/manifest.json" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
