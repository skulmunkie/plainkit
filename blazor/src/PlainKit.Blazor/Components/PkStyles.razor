@* Links the toolkit's stylesheet where it is written: a plain <link>, in place. The toolkit's base layer (tokens, resets, utilities) has to come
   BEFORE the application's own stylesheets so the app's rules win, so put <PkStyles /> in the <head> of App.razor above the app's links (see the
   README, "Where the stylesheet goes"). Written in a layout it lands in the body, after the app's head links; InHead (HeadContent) is the old
   behaviour and puts it after them, in HeadOutlet. *@
@if (InHead)
{
    <HeadContent>
        <link rel="stylesheet" href="@Href" />
        @if (Preload) { foreach (var path in PkAssets.PreloadPaths) { <link rel="modulepreload" href="@PkAssets.Versioned(path)" /> } }
    </HeadContent>
}
else
{
    <link rel="stylesheet" href="@Href" />
    @if (Preload) { foreach (var path in PkAssets.PreloadPaths) { <link rel="modulepreload" href="@PkAssets.Versioned(path)" /> } }
}

@code {
    /// <summary>The minified stylesheet (<see cref="PkAssets.CssMin"/>) instead of <see cref="PkAssets.Css"/>. Same rules.</summary>
    [Parameter] public bool Minified { get; set; }

    /// <summary>
    /// Links a versioned URL, so a browser fetches the file again exactly when it changed: the host's fingerprinted static asset URL
    /// (<c>Assets[...]</c>, from <c>Microsoft.AspNetCore.Components.Web</c>) when the app calls <c>app.MapStaticAssets()</c> (the default since
    /// ASP.NET Core 9; served with a year-long, immutable <c>Cache-Control</c>), or a content-hash <c>?v=</c> query (<see cref="PkAssets.Versioned"/>,
    /// still revalidated every visit) otherwise. On by default.
    /// </summary>
    [Parameter] public bool Versioned { get; set; } = true;

    /// <summary>
    /// Render the link through <c>HeadContent</c> (into <c>HeadOutlet</c>) instead of in place. That puts it after the app's own stylesheets in the
    /// standard <c>App.razor</c>, so the toolkit's base layer overrides app rules of equal specificity: leave it off unless you know you want that.
    /// </summary>
    [Parameter] public bool InHead { get; set; }

    /// <summary>
    /// Also emit a <c>&lt;link rel="modulepreload"&gt;</c> for each of <see cref="PkAssets.PreloadPaths"/> (the loader, its logger, the element
    /// registry and the base every element shares): the browser fetches them in parallel with the entry module instead of one round trip at a
    /// time as each is discovered. Off by default; worth turning on for a page that uses <c>pk-*</c> elements.
    /// </summary>
    [Parameter] public bool Preload { get; set; }

    private string Href
    {
        get
        {
            var path = Minified ? PkAssets.CssMin : PkAssets.Css;
            if (!Versioned) return path;
            var fingerprinted = Assets[path];
            // Assets[...] returns the path unchanged when the host has no fingerprinted URL for it (MapStaticAssets not called, or an older host):
            // fall back to the content-hash query so the link is still versioned.
            return fingerprinted != path ? fingerprinted : (Minified ? PkAssets.CssMinVersioned : PkAssets.CssVersioned);
        }
    }
}
