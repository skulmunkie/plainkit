@implements IAsyncDisposable
@inject PkRuntime Runtime

@* The toolkit's theme editor: every design token with an input, a brand palette generator, presets and saved themes, undo and redo, a change list, export
   and shareable links, and a live contrast audit; edits applied live to the page. JavaScript owns everything inside the container; Blazor renders nothing in it. *@
<div @ref="_host"></div>

@code {
    private ElementReference _host;
    private IJSObjectReference? _bridge;
    private DotNetObjectReference<PkThemeEditorHost>? _callbacks;
    private string? _mounted;

    /// <summary>A localStorage key that keeps the edits between visits. Null keeps none.</summary>
    [Parameter] public string? StorageKey { get; set; }

    /// <summary>Show the Preview tab with sample controls.</summary>
    [Parameter] public bool Preview { get; set; } = true;

    /// <summary>The theme the editor starts on (the page's theme); <see cref="PkTheme.Auto"/> takes the page's current one.</summary>
    [Parameter] public PkTheme Theme { get; set; }

    /// <summary>Any CSS length: the token list scrolls inside it.</summary>
    [Parameter] public string? Height { get; set; }

    /// <summary>
    /// The theme to start from: the override block CSS the editor exports, or its JSON <c>{ "shared": {}, "dark": {}, "light": {} }</c>. Used when nothing was kept for
    /// the viewer under <see cref="StorageKey"/>; the edits are ordinary ones the user can change and undo. Text that holds no usable token is logged and ignored.
    /// </summary>
    [Parameter] public string? InitialTheme { get; set; }

    /// <summary>Presets of your own, listed after the built-in ones (default, high contrast, compact and roomy) in the Presets tab. A bad entry is logged and left out.</summary>
    [Parameter] public IReadOnlyList<PkThemePreset>? Presets { get; set; }

    /// <summary>
    /// Raised after every change (a moment after typing stops) with the override block CSS for the edits made so far: the text to save as the app's theme file
    /// and load after the SDK stylesheets (see the package README, "Shipping an exported theme").
    /// </summary>
    [Parameter] public EventCallback<string> OnThemeChanged { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _bridge ??= await Runtime.BridgeAsync(Assets);
        var presetKey = Presets is null ? "" : string.Join("", Presets.Select(p => $"{p.Name}{p.Theme}{p.Description}"));
        var key = $"{StorageKey}|{Preview}|{Theme}|{Height}|{InitialTheme}|{presetKey}|{OnThemeChanged.HasDelegate}";
        if (key == _mounted) return;
        _mounted = key;
        _callbacks?.Dispose();
        _callbacks = OnThemeChanged.HasDelegate ? DotNetObjectReference.Create(new PkThemeEditorHost(css => InvokeAsync(() => OnThemeChanged.InvokeAsync(css)))) : null;
        var presets = Presets?.Select(p => new { name = p.Name, description = p.Description, theme = p.Theme }).ToArray();
        await _bridge.InvokeVoidAsync("mountThemeEditor", _host, new { storageKey = StorageKey, preview = Preview, theme = Theme.Attr(), height = Height, initial = InitialTheme, presets }, _callbacks);
    }

    /// <summary>The override block (CSS) for the edits made so far.</summary>
    public async Task<string?> ExportAsync() => _bridge is null ? null : await _bridge.InvokeAsync<string?>("exportTheme", _host);

    /// <summary>Switches the theme being edited.</summary>
    public async Task SetThemeAsync(PkTheme theme)
    {
        if (_bridge is not null && theme.Attr() is { } name) await _bridge.InvokeVoidAsync("setThemeMode", _host, name);
    }

    /// <summary>Drops every edit.</summary>
    public async Task ResetAsync()
    {
        if (_bridge is not null) await _bridge.InvokeVoidAsync("reset", _host);
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _callbacks?.Dispose();
        if (_bridge is null) return;
        try { await _bridge.InvokeVoidAsync("destroy", _host); }
        catch (JSDisconnectedException) { /* the circuit is gone */ }
    }
}
