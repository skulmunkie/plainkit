@namespace PlainKit.Blazor
@using System.Text.Json
@inherits PkElementBase
@implements IDisposable

@* Hand-written (blazor/mappings/settings-page.json marks it "existing"): the element's save(values) is a callback property, set from script, so
   this component hands it a .NET reference (PkCallbackSlot) that calls Save. A Save that throws shows its message in the element's status bar. *@
<pk-settings-page config="@Config"
                  values="@Values"
                  @ref="Element"
                  class="@Css()"
                  @attributes="Splat"></pk-settings-page>

@code {
    [Inject] private PkRuntime Runtime { get; set; } = default!;

    private readonly PkCallbackSlot _save = new("save");

    /// <summary>{ sections: [{ heading, fields: [{ key, type, label, placeholder?, required?, options?, min?, max?, step? }] }] }, sent as a JSON attribute.</summary>
    [Parameter] public string? Config { get; set; } = "{}";

    /// <summary>The current values keyed by field key, as JSON. Set it again once loaded values arrive to refresh the fields and take a new baseline.</summary>
    [Parameter] public string? Values { get; set; } = "{}";

    /// <summary>
    /// Saves the values of the fields, keyed by field key (read text with <c>GetString()</c>, a switch with <c>GetBoolean()</c>). Throwing keeps the unsaved
    /// changes and shows the exception message; returning marks them saved.
    /// </summary>
    [Parameter] public Func<IReadOnlyDictionary<string, JsonElement>, Task>? Save { get; set; }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        await _save.SyncAsync<Dictionary<string, JsonElement>>(await Runtime.BridgeAsync(Assets), Element, Save is not null, async values => { await Save!(values); return null; });
    }

    /// <inheritdoc />
    public void Dispose() => _save.Dispose();
}
