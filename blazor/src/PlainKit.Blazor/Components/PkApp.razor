@namespace PlainKit.Blazor
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Routing
@using PlainKit.Blazor.Components
@using PlainKit.Blazor.Shells
@implements IDisposable
@inject PkModuleCatalog Catalog
@inject NavigationManager Nav
@inject IPkTheme Theme

@* Hand-written (#364, step 3): the app frame over the module catalog. It composes the elements the SDK shell composes (pk-app-shell, pk-navbar, pk-side-nav,
   pk-breadcrumb, pk-app-bar-search) and hooks Blazor's own router: the PkSideNav shape. The page is @Body (ChildContent); where the reader is comes
   from PkNavModel (the fixture-backed port of appLocate). No behaviour of its own: no timers, no routing, no guard (step 4). *@
<PkSkipLink Href="#pk-main">Skip to content</PkSkipLink>
<PkAppShell>
    <HeaderContent>
        <PkNavbar NoFold="true">
            <BrandContent><a href="@Url("/")">@Catalog.Brand</a></BrandContent>
            <ChildContent>
                @if (Catalog.Modules.Count > 1)
                {
                    <PkDropdown>
                        <TriggerContent><PkButton Variant="ButtonVariant.Ghost" AriaLabel="Switch module">@Title(_active)</PkButton></TriggerContent>
                        <ChildContent>@foreach (var m in Catalog.Modules) {<PkMenuItem Href="@Url("/" + m.Manifest.Id)">@m.Manifest.Title</PkMenuItem>}</ChildContent>
                    </PkDropdown>
                }
            </ChildContent>
            <ActionsContent>
                <PkAppBarSearch Placeholder="Search" Items="_found" OnQuery="Search" OnSelect="Go" />
                <PkDropdown Placement="bottom-end">
                    <TriggerContent><PkButton Variant="ButtonVariant.Ghost" AriaLabel="Settings menu"><PkIcon Name="settings" /></PkButton></TriggerContent>
                    <ChildContent><PkMenuItem Value="theme" OnSelect="ToggleTheme">Toggle theme</PkMenuItem></ChildContent>
                </PkDropdown>
            </ActionsContent>
        </PkNavbar>
    </HeaderContent>
    <SidebarContent>
        @if (_active?.Manifest.Nav is { Count: > 0 } nav)
        {
            <PkSideNav Label="@(Title(_active) + " menu")">@Items(nav)</PkSideNav>
        }
    </SidebarContent>
    <BodyContent>
        <main id="pk-main" tabindex="-1">
            <PkStack Gap="md">
                <PkBreadcrumb>@foreach (var (c, i) in (_loc?.Crumbs ?? []).Select((c, i) => (c, i))) {<a href="@(c.Href is null ? null : Url(c.Href))" aria-current="@(i == _loc!.Crumbs.Count - 1 ? "page" : null)">@c.Label</a>}</PkBreadcrumb>
                @ChildContent
            </PkStack>
        </main>
    </BodyContent>
    <FooterContent>@Catalog.Footer</FooterContent>
</PkAppShell>

@code {
    private PkNavLocation? _loc;
    private IPkModule? _active;
    private IReadOnlyList<PkAppBarSearchItem> _found = [];

    /// <summary>The page: the router's body.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        Where();
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Theme.InitializeAsync();
    }

    private void Where()
    {
        _loc = PkNavModel.Locate(Catalog.Modules.Select(m => m.Manifest), Catalog.Brand, "/" + Nav.ToBaseRelativePath(Nav.Uri));
        _active = (_loc is null ? null : Catalog.Get(_loc.Module)) ?? (Catalog.Home is { } h ? Catalog.Get(h) : null) ?? Catalog.Modules.FirstOrDefault();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        Where();
        _ = InvokeAsync(StateHasChanged);
    }

    private string Url(string appPath) => Nav.ToAbsoluteUri(appPath.TrimStart('/')).ToString();

    private static string Title(IPkModule? m) => m?.Manifest.Title ?? "Modules";

    private RenderFragment Items(IEnumerable<PkManifestNavItem> items) => @<text>@foreach (var n in items) {
        <PkNavItem Href="@(n.Route is null ? n.Href : Url("/" + _active!.Manifest.Id + (n.Route == "/" ? "" : n.Route)))" Current="@(n.Id == _loc?.Current)" Expanded="@(_loc?.Ids.Contains(n.Id) == true)"
                   ChildContent="@Text(n.Title)" IconContent="@(n.Icon is null ? null : Icon(n.Icon))" BadgeContent="@(n.Badge is null ? null : Text(n.Badge))" ChildrenContent="@(n.Children is { Count: > 0 } kids ? Items(kids) : null)" />
    }</text>;

    private static RenderFragment Text(string s) => @<text>@s</text>;

    private static RenderFragment Icon(string name) => @<PkIcon Name="@name" />;

    // The default search: nav entries whose title contains the query, like the SDK's searchNav.
    private void Search(PkQueryEventArgs e)
    {
        var q = e.Query?.Trim() ?? "";
        _found = q.Length == 0 || _active?.Manifest.Nav is null ? [] : Flat(_active.Manifest.Nav).Where(n => n.Route is not null && n.Title.Contains(q, StringComparison.OrdinalIgnoreCase))
            .Take(8).Select(n => new PkAppBarSearchItem { Id = "/" + _active.Manifest.Id + (n.Route == "/" ? "" : n.Route), Label = n.Title }).ToList();
    }

    private static IEnumerable<PkManifestNavItem> Flat(IEnumerable<PkManifestNavItem> items) => items.SelectMany(n => new[] { n }.Concat(Flat(n.Children ?? [])));

    private void Go(PkSelectEventArgs e)
    {
        if (e.Item?.Deserialize<PkAppBarSearchItem>(new JsonSerializerOptions(JsonSerializerDefaults.Web)) is { Id.Length: > 0 } item) Nav.NavigateTo(Url(item.Id));
    }

    private async Task ToggleTheme() => await Theme.ToggleAsync();

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
