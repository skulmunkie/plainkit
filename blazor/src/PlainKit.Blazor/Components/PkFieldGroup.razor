@namespace PlainKit.Blazor
@typeparam TItem
@using System.Linq

@* Hand-written, no element of its own (issue 222): renders a PkField + the right control for each PkFieldSpec, reading and writing
   Model through the spec's Get/Set. It never subsumes a computed value; that stays hand-written next to it. A field with a When
   predicate (issue 226) re-evaluates it on every render -- Blazor re-renders this component after every commit (Update calls
   ModelChanged, which the caller's own state update normally triggers a re-render from), so a field that gates another one just
   works without extra wiring. A field whose When is false renders nothing at all, so a hidden Required field is not in the DOM for
   PkForm's validation to see.
   Each control's own two-way ValueChanged/CheckedChanged already commits before this component sees it, the same as writing the
   field by hand -- pk-form's own validation needs nothing extra either, since these are the same real elements a hand-written field
   would use. *@
@foreach (var f in Fields.Where(f => f.When is null || f.When(Model)))
{
    <PkField Label="@f.Label" Hint="@f.Hint" Required="@f.Required" LabelExtra="@HelpFor(f)">
        @if (f.Kind == PkFieldKind.Select)
        {
            <PkSelect name="@f.Key" Value="@f.Get(Model)" ValueChanged="@(v => Update(f, v))" Required="@f.Required">
                @foreach (var o in f.Options ?? [])
                {
                    <option value="@o.Value">@o.Label</option>
                }
            </PkSelect>
        }
        else if (f.Kind == PkFieldKind.Textarea)
        {
            <PkTextarea Name="@f.Key" Value="@f.Get(Model)" ValueChanged="@(v => Update(f, v))" Required="@f.Required" MaxLength="@f.MaxLength"
                        Placeholder="@f.Placeholder" Rows="@(f.Rows ?? 3)" />
        }
        else if (f.Kind == PkFieldKind.Checkbox)
        {
            <PkCheckbox name="@f.Key" Checked="@IsChecked(f.Get(Model))" CheckedChanged="@(v => Update(f, v ? "true" : ""))" Required="@f.Required" />
        }
        else
        {
            <PkInput Name="@f.Key" Placeholder="@f.Placeholder" Type="@InputType(f.Kind)" Value="@f.Get(Model)" ValueChanged="@(v => Update(f, v))" Required="@f.Required"
                     Min="@f.Min" Max="@f.Max" Step="@f.Step" MaxLength="@f.MaxLength" Pattern="@f.Pattern" />
        }
    </PkField>
}

@code {
    /// <summary>The fields to render, in order.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<PkFieldSpec<TItem>> Fields { get; set; } = [];

    /// <summary>The bound record; each field's <c>Get</c> reads it, each commit calls <c>Set</c> then <see cref="ModelChanged"/>.</summary>
    [Parameter, EditorRequired] public TItem Model { get; set; } = default!;

    /// <summary>Raised after any field commits a change (the model was already updated in place through <c>Set</c>).</summary>
    [Parameter] public EventCallback ModelChanged { get; set; }

    private static string InputType(PkFieldKind kind) => kind switch
    {
        PkFieldKind.Number => "number",
        PkFieldKind.Email => "email",
        PkFieldKind.Password => "password",
        PkFieldKind.Date => "date",
        PkFieldKind.Time => "time",
        PkFieldKind.Url => "url",
        PkFieldKind.Tel => "tel",
        _ => "text",
    };

    private static RenderFragment? HelpFor(PkFieldSpec<TItem> f) => string.IsNullOrEmpty(f.Help) ? null : (builder =>
    {
        builder.OpenComponent<PkTooltip>(0);
        builder.AddAttribute(1, nameof(PkTooltip.Help), true);
        builder.AddAttribute(2, nameof(PkTooltip.Text), f.Help);
        builder.CloseComponent();
    });

    private static bool IsChecked(string? value) => !string.IsNullOrEmpty(value) && value != "false";

    private async Task Update(PkFieldSpec<TItem> f, string? value)
    {
        f.Set(Model, value);
        await ModelChanged.InvokeAsync();
    }
}
