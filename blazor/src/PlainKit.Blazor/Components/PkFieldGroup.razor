@namespace PlainKit.Blazor.Components
@typeparam TItem
@using System.Text.Json
@inherits PkElementBase
@implements IDisposable

@* Hand-written (mapping "existing"): a typed wrapper over pk-field-group, which owns the controls, the conditional rendering, the form value, the validation and pk-form's summary (#222, #226).
   It only turns PkFieldSpec<TItem> items and a model into the element's fields and values, and the element's pk-field-change back into each spec's Set. The funcs of a spec (When, Disabled,
   ReadOnly, HelpWhen, OptionsSource) are read on every render and sent as data; a field whose When is false is not sent at all. LabelAction is slotted for its field; Search is the element's
   search callback. *@
<pk-field-group fields="@PkAttr.Json(Defs())"
                values="@Values()"
                @ref="Element"
                class="@Css()"
                @attributes="Splat">
    @foreach (var f in Visible().Where(f => f.LabelAction is not null))
    {
        <span slot="@($"label-action-{f.Key}")">@f.LabelAction!(Model)</span>
    }
</pk-field-group>

@code {
    [Inject] private PkRuntime Runtime { get; set; } = default!;

    private readonly PkCallbackSlot _search = new("search");

    /// <summary>The fields to render, in order.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<PkFieldSpec<TItem>> Fields { get; set; } = [];

    /// <summary>The bound record; each field's <c>Get</c> reads it, each commit calls <c>Set</c> then <see cref="ModelChanged"/>.</summary>
    [Parameter, EditorRequired] public TItem Model { get; set; } = default!;

    /// <summary>Raised after any field commits a change (the model was already updated in place through <c>Set</c>). A handler on the parent re-renders it, and with it this group: its
    /// <c>Get</c>, <c>When</c>, <c>Disabled</c> and <c>HelpWhen</c> are read again.</summary>
    [Parameter] public EventCallback ModelChanged { get; set; }

    private IEnumerable<PkFieldSpec<TItem>> Visible() => Fields.Where(f => f.When is null || f.When(Model));

    private IReadOnlyList<PkFieldDef> Defs() => Visible().Select(f =>
    {
        // PkSelect and PkCheckbox have no read-only state, so there it disables the control.
        var text = f.Kind is not (PkFieldKind.Select or PkFieldKind.Checkbox or PkFieldKind.Combobox);
        var readOnly = f.ReadOnly?.Invoke(Model) ?? false;
        var help = f.HelpWhen?.Invoke(Model);
        return new PkFieldDef
        {
            Key = f.Key, Label = f.Label, Kind = f.Kind.ToString().ToLowerInvariant(), Hint = f.Hint, Help = string.IsNullOrEmpty(help) ? f.Help : help, Required = f.Required,
            Disabled = (f.Disabled?.Invoke(Model) ?? false) || (readOnly && !text), Readonly = readOnly && text, HideLabel = f.HideLabel, Span = f.Span, Placeholder = f.Placeholder,
            Min = f.Min, Max = f.Max, Step = f.Step, MaxLength = f.MaxLength, Pattern = f.Pattern, Rows = f.Rows, Options = f.OptionsSource?.Invoke() ?? f.Options, Free = f.Free,
        };
    }).ToList();

    // The values as JSON with the keys as the specs spell them: a checkbox is a boolean, everything else the string Get returns.
    private string Values() => JsonSerializer.Serialize(Visible().ToDictionary(f => f.Key,
        f => f.Kind == PkFieldKind.Checkbox ? !string.IsNullOrEmpty(f.Get(Model)) && f.Get(Model) != "false" : (object?)f.Get(Model)));

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        await _search.SyncAsync<PkFieldSearch>(await Runtime.BridgeAsync(Assets), Element, Fields.Any(f => f.Search is not null),
            async a => (object?)await Fields.First(f => f.Key == a.Key).Search!(a.Query), refresh: true);
    }

    /// <inheritdoc />
    protected override void AddEventHandlers(Dictionary<string, object> handlers) =>
        handlers["onpk-field-change"] = EventCallback.Factory.Create<PkFieldChangeEventArgs>(this, Changed);

    private async Task Changed(PkFieldChangeEventArgs e)
    {
        var f = Fields.FirstOrDefault(f => f.Key == e.Key);
        if (f is null || e.Value is not { } v) return;
        f.Set(Model, v.ValueKind switch { JsonValueKind.True => "true", JsonValueKind.False => "", JsonValueKind.Null or JsonValueKind.Undefined => null, JsonValueKind.String => v.GetString(), _ => v.GetRawText() });
        await ModelChanged.InvokeAsync();
    }

    /// <inheritdoc />
    public void Dispose() => _search.Dispose();
}
