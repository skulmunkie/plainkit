@implements IAsyncDisposable
@inject PkRuntime Runtime

@* The toolkit's page quality checks (accessibility, layout, spacing, touch targets, focus) on the page this component is in, with a score and every finding.
   JavaScript owns everything inside the container; Blazor renders nothing in it. *@
<div @ref="_host"></div>

@code {
    private ElementReference _host;
    private IJSObjectReference? _bridge;
    private string? _mounted;

    /// <summary>Force the phone checks on or off. Null checks them when the window is 640px wide or less.</summary>
    [Parameter] public bool? Phone { get; set; }

    /// <summary>Run as soon as it is mounted.</summary>
    [Parameter] public bool AutoRun { get; set; }

    /// <summary>The theme of the module itself.</summary>
    [Parameter] public PkTheme Theme { get; set; }

    /// <summary>Any CSS length, or "fill".</summary>
    [Parameter] public string? Height { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _bridge ??= await Runtime.BridgeAsync(Assets);
        var key = $"{Phone}|{AutoRun}|{Theme}|{Height}";
        if (key == _mounted) return;
        _mounted = key;
        await _bridge.InvokeVoidAsync("mountQuality", _host, new { phone = Phone, autorun = AutoRun, theme = Theme.Attr(), height = Height });
    }

    /// <summary>Checks the page now.</summary>
    public async Task RunAsync()
    {
        if (_bridge is not null) await _bridge.InvokeVoidAsync("run", _host);
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_bridge is null) return;
        try { await _bridge.InvokeVoidAsync("destroy", _host); }
        catch (JSDisconnectedException) { /* the circuit is gone */ }
    }
}
