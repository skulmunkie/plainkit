@namespace PlainKit.Blazor

@* Hand-written, no element of its own (issue #728): the "..." or settings button of a card header that opens a menu of secondary actions. A
   PkDropdown opened by an icon-only PkButton, so the keyboard, the focus return and the placement are the dropdown's. Put it in
   PkCard.ActionsContent (or any header's actions slot) and give it PkMenuItem children. *@
<PkDropdown Placement="@Placement" OnSelect="OnSelect" Open="Open" OpenChanged="OpenChanged" @attributes="AdditionalAttributes">
    <TriggerContent>
        <PkButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Mini" Icon="true" IconName="@IconName" AriaLabel="@Label" />
    </TriggerContent>
    <ChildContent>@ChildContent</ChildContent>
</PkDropdown>

@code {
    /// <summary>Attributes that match no parameter (<c>id</c>, <c>data-*</c>, <c>class</c>) go on the dropdown.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>The menu items, usually <c>PkMenuItem</c>s (give each a <c>Value</c> to tell them apart in <see cref="OnSelect"/>, or an <c>Href</c>).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The accessible name of the button, which is also its tooltip. Default "Card actions"; name what the menu acts on when a page has several ("Orders actions").</summary>
    [Parameter] public string Label { get; set; } = "Card actions";

    /// <summary>The icon of the button: <c>more</c> (the default) or <c>settings</c>, or any other icon name.</summary>
    [Parameter] public string IconName { get; set; } = "more";

    /// <summary>Which side the menu opens on. Default <c>bottom-end</c>, since the button sits at the end of the header.</summary>
    [Parameter] public string Placement { get; set; } = "bottom-end";

    /// <summary>Whether the menu is open (two-way: <c>@bind-Open</c>).</summary>
    [Parameter] public bool Open { get; set; }

    /// <summary>Raised when <see cref="Open"/> changes.</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>An item was chosen; <c>Value</c> is that item's value.</summary>
    [Parameter] public EventCallback<PkSelectEventArgs> OnSelect { get; set; }
}
