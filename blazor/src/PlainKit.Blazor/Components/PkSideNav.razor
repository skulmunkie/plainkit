@namespace PlainKit.Blazor
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@inherits PkElementBase
@implements IDisposable

@* Hand-written (blazor/mappings/side-nav.json marks it "existing"): the generator can express every prop and event, but not
   router interop, so this component owns it instead. CurrentPath, given by the host, always wins; otherwise the component
   tracks NavigationManager.Uri itself (issue 210), the first component in the package to hook Blazor's own router rather
   than only exchange attributes and events with the element. A future route-aware component (a breadcrumb, an app-bar
   search closing on navigation) follows the same shape: inject NavigationManager, keep a private tracked value, offer an
   explicit override parameter that always wins, unsubscribe in Dispose. *@
<pk-side-nav label="@Label"
             collapsed="@Collapsed"
             open="@Open"
             filterable="@Filterable"
             persist="@Persist"
             current-path="@EffectivePath"
             auto-expand-active="@AutoExpandActive"
             @ref="Element"
             class="@Css()"
             @attributes="Splat">@if (BrandContent is not null) {<span slot="brand">@BrandContent</span>}@ChildContent@if (FooterContent is not null) {<span slot="footer">@FooterContent</span>}</pk-side-nav>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private string? _trackedPath;

    /// <summary>Accessible name</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Icon rail.</summary>
    [Parameter] public bool Collapsed { get; set; }

    /// <summary>Raised when Collapsed changes (two-way binding: <c>@bind-Collapsed</c>).</summary>
    [Parameter] public EventCallback<bool> CollapsedChanged { get; set; }

    /// <summary>Drawer open (phones and tablets).</summary>
    [Parameter] public bool Open { get; set; }

    /// <summary>Raised when Open changes (two-way binding: <c>@bind-Open</c>).</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Show the filter box.</summary>
    [Parameter] public bool Filterable { get; set; }

    /// <summary>localStorage key for collapsed and open branches.</summary>
    [Parameter] public string? Persist { get; set; }

    /// <summary>
    /// The current URL path, for active-row resolution and (with <see cref="AutoExpandActive"/>) branch auto-expand. Set it to override; left
    /// unset, the component tracks <see cref="NavigationManager"/> itself (issue 210) so the usual case needs no wiring at all.
    /// </summary>
    [Parameter] public string? CurrentPath { get; set; }

    private string? EffectivePath => CurrentPath ?? _trackedPath;

    /// <summary>With the resolved path, also opens every ancestor branch of the active row and collapses every other branch.</summary>
    [Parameter] public bool AutoExpandActive { get; set; }

    /// <summary>Brand link.</summary>
    [Parameter] public RenderFragment? BrandContent { get; set; }

    /// <summary>pk-nav-item children; a pk-nav-item with the group attribute is a group title.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Pinned bottom items.</summary>
    [Parameter] public RenderFragment? FooterContent { get; set; }

    /// <summary>Rail toggled by the user, or restored from the saved state (persist) on connect.</summary>
    [Parameter] public EventCallback<bool> OnToggle { get; set; }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        _trackedPath = new Uri(Nav.Uri).AbsolutePath;
        Nav.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _trackedPath = new Uri(e.Location).AbsolutePath;
        if (CurrentPath is null) InvokeAsync(StateHasChanged);
    }

    /// <inheritdoc />
    protected override void AddEventHandlers(Dictionary<string, object> handlers)
    {
        handlers["onpk-nav-toggle"] = EventCallback.Factory.Create<PkNavToggleEventArgs>(this, HandlePkNavToggle);
        handlers["onpk-close"] = EventCallback.Factory.Create<PkCloseEventArgs>(this, HandlePkClose);
    }

    private async Task HandlePkNavToggle(PkNavToggleEventArgs e)
    {
        Collapsed = e.Collapsed == true;
        await CollapsedChanged.InvokeAsync(Collapsed);
        await OnToggle.InvokeAsync(e.Collapsed == true);
    }

    private async Task HandlePkClose(PkCloseEventArgs e)
    {
        Open = false;
        await OpenChanged.InvokeAsync(Open);
    }

    /// <inheritdoc />
    public void Dispose() => Nav.LocationChanged -= HandleLocationChanged;
}
