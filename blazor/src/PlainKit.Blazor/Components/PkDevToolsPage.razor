@page "/_plainkit"
@page "/_plainkit/{Tab}"
@inject NavigationManager Nav

@* The toolkit's own dev tools, in your app, all built from the SDK. Served at /_plainkit in Development (see PkOptions.DevTools).
   The workspaces (gallery, files, scorecard) and the dock's tools (console, logs, logging, performance, quality, inspector, theme, and PlainKit.Blazor's own blazor and
   components tabs) are one SDK module, mounted by PkDevToolsWorkspace: /_plainkit/console and the like open the dock on that tab. *@
<PkDevToolsWorkspace Tab="@Tab" OnWorkspace="@(key => Nav.NavigateTo($"/_plainkit/{key}"))" />

@code {
    /// <summary>A workspace (gallery, files or scorecard), or the id of a dock tab to open (console, logs, logging, performance, quality, inspector, theme, blazor, blazor-components).</summary>
    [Parameter] public string? Tab { get; set; }
}
