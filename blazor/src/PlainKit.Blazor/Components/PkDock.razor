@namespace PlainKit.Blazor.Components
@using System.Text.Json
@inherits PkElementBase
@implements IDisposable

@* Hand-written (blazor/mappings/dock.json marks it "existing", issue #592): controlled mode. Not set, ConfirmLayout is unchanged from PR #540 -
   the element is free-running (a resize or tab change applies right away, then fires pk-layout-change). ConfirmLayout set, the element's
   confirmLayout(arg) callback property holds every change (arg is { layout, reason }) until the delegate settles: it hands the element a .NET
   reference (PkCallbackSlot) the same way pk-tool-page's run is wired, so config stays data and a callback is set from script (STANDARDS.md). A
   Task result is the confirmed layout json to apply, or null to keep the previous one; a delegate that throws also keeps the previous layout
   (the element's own catch, not shown here). *@
<pk-dock layout="@Layout"
         label="@Label"
         resize-label="@ResizeLabel"
         fill="@Fill"
         @ref="Element"
         class="@Css()"
         @attributes="Splat">@ChildContent</pk-dock>

@code {
    [Inject] private PkRuntime Runtime { get; set; } = default!;

    private readonly PkCallbackSlot _confirm = new("confirmLayout");

    /// <summary>The arrangement: { version, seq, root } where root is a split { id, type: 'split', orientation, size, min, max, a, b } or a tab group { id, type: 'tabs', active, panels }. Leave it unset for the default arrangement derived from each panel's data-group. The element validates what it is given (panels that are not declared are dropped, panels the layout lacks are added, bad numbers are repaired). While the user resizes or chooses a tab the element owns it (or, with <see cref="ConfirmLayout"/> set, holds it for confirmation); after pk-layout-change the host does. Property or a JSON attribute.</summary>
    [Parameter] public string? Layout { get; set; }

    /// <summary>Raised when Layout changes (two-way binding: <c>@bind-Layout</c>). With <see cref="ConfirmLayout"/> set, this only raises once a proposed change has been confirmed.</summary>
    [Parameter] public EventCallback<string?> LayoutChanged { get; set; }

    /// <summary>Accessible name of a tab group (aria-label), for example the workspace's name. A single-panel group is named by its heading.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Accessible name of every separator between two panels (aria-label).</summary>
    [Parameter] public string? ResizeLabel { get; set; }

    /// <summary>Fill the height the parent gives it (a parent with a definite height, or a flex or grid parent) instead of --pk-dock-height.</summary>
    [Parameter] public bool Fill { get; set; }

    /// <summary>The arrangement changed because of the user or because panels were added or removed: reason is resize (a drag ended or a key moved a separator), activate (a tab was chosen) or panels (the declared panels changed and the layout was repaired). layout is the new document. Not raised for a layout the host set, nor for the first render. Not cancelable. With <see cref="ConfirmLayout"/> set, raised only once the change is confirmed, with the confirmed layout (which may differ from what was proposed).</summary>
    [Parameter] public EventCallback<PkLayoutChangeEventArgs> OnLayoutChange { get; set; }

    /// <summary>
    /// Turns on controlled mode: every resize, tab switch or panel repair holds before the element applies it, calling this delegate with the
    /// proposed layout (as JSON, the same shape as <see cref="Layout"/>) and the reason (resize, activate or panels). Return the layout json to
    /// apply (typically the proposed one, stored first and returned unchanged, or a different one .NET computed), or null to keep the previous
    /// layout unchanged. A delegate that throws also keeps the previous layout. Left null (the default), the element is free-running: unchanged
    /// from the bindable-but-element-owned behaviour of PR #540.
    /// </summary>
    [Parameter] public Func<string, string, Task<string?>>? ConfirmLayout { get; set; }

    /// <summary>The panels: children with slot="&lt;panel id&gt;", so the slot is not a fixed one (the element slots each panel by its own id).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <inheritdoc />
    protected override void AddEventHandlers(Dictionary<string, object> handlers)
    {
        handlers["onpk-layout-change"] = EventCallback.Factory.Create<PkLayoutChangeEventArgs>(this, HandlePkLayoutChange);
    }

    private async Task HandlePkLayoutChange(PkLayoutChangeEventArgs e)
    {
        Layout = e.Layout?.ToString();
        await LayoutChanged.InvokeAsync(Layout);
        await OnLayoutChange.InvokeAsync(e);
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        // The callback delegates to the current ConfirmLayout, so a new delegate needs no new setup; only set versus unset matters.
        await _confirm.SyncAsync<PkLayoutChangingRequest>(await Runtime.BridgeAsync(Assets), Element, ConfirmLayout is not null,
            async request => (object?)await ConfirmLayout!(request.Layout, request.Reason));
    }

    /// <inheritdoc />
    public void Dispose() => _confirm.Dispose();
}
