@namespace PlainKit.Blazor
@typeparam TItem
@using System.Globalization
@using System.Text.Json
@using System.Text.Json.Nodes
@inherits PkElementBase

@* Hand-written (blazor/mappings/table.json marks it "existing"): a typed data table over <pk-table>.
   Attributes down: the columns and the rows are JSON attributes (camelCase), rebuilt when the parameters are set, never per render and never
   through JavaScript. Events up: pk-sort, pk-filter, pk-select, pk-row-click and pk-row-expand reach the callbacks (registered for Blazor by
   PlainKit.Blazor.lib.module.js). Cell templates, the detail template and the slots are ordinary Blazor children of the element (the element
   reads them, it never rewrites them): a cell template is a <span slot="cell-<id>-<key>"> per row, so a change of rows re-renders them together
   with the rows attribute. *@
<pk-table columns="@_columns"
          rows="@_rows"
          row-key="id"
          manual="@Manual"
          sort="@Sort"
          sort-dir="@(SortDirection?.ToAttr())"
          filters="@PkAttr.JsonVerbatimKeys(Filters)"
          selected="@PkAttr.Json(Selected)"
          expanded="@PkAttr.Json(Expanded)"
          selectable="@Selectable"
          clickable="@Clickable"
          current-row="@CurrentRow"
          filterable="@Filterable"
          expandable="@Expandable"
          loading="@Loading"
          empty-text="@EmptyText"
          cards="@Cards"
          striped="@Striped"
          hover="@Hover"
          bordered="@Bordered"
          density="@(Density?.ToAttr())"
          sticky-header="@StickyHeader"
          sticky-column="@StickyColumn"
          max-height="@MaxHeight"
          caption="@Caption"
          label="@Label"
          flow="@Flow"
          class="@Css()"
          @attributes="Splat">@if (ToolbarContent is not null) {<pk-cluster slot="toolbar">@ToolbarContent</pk-cluster>}@if (BulkContent is not null) {<span slot="bulk">@BulkContent</span>}@if (CaptionContent is not null) {<span slot="caption">@CaptionContent</span>}@if (EmptyContent is not null) {<div slot="empty">@EmptyContent</div>}@if (FooterContent is not null) {<div slot="footer">@FooterContent</div>}@foreach (var row in _items)
{
    @foreach (var column in _cells)
    {
        <span slot="@($"cell-{row.Id}-{column.Key}")" @key="@($"cell-{row.Id}-{column.Key}")">@column.Cell!(row.Item)</span>
    }
    @if (Expandable && DetailTemplate is not null)
    {
        <div slot="@($"detail-{row.Id}")" @key="@($"detail-{row.Id}")">@DetailTemplate(row.Item)</div>
    }
}</pk-table>

@code {
    private sealed record Row(string Id, TItem Item);

    private static readonly JsonSerializerOptions Web = new(JsonSerializerDefaults.Web);

    private string _columns = "[]";
    private string _rows = "[]";
    private List<Row> _items = [];
    private List<PkTableColumn<TItem>> _cells = [];
    private readonly Dictionary<string, TItem> _byId = new();

    /// <summary>The columns: what the header says, how it sorts, and what fills the cells. A key names an item property in any casing (or is any name, when the column has a <c>Text</c> or a <c>Cell</c>) and is used exactly as given: in the column definition, the row, the cell slot and the sort and filter keys the table reports (<c>Sort</c>, <c>OnSort</c>, <c>Filters</c>).</summary>
    [Parameter] public IReadOnlyList<PkTableColumn<TItem>>? Columns { get; set; }

    /// <summary>The rows, one item each. In manual mode these are the rows the server returned for the current page. They are sent to the element as JSON (camelCase), so a row holds the item's public properties; a cell template can use the whole item.</summary>
    [Parameter] public IReadOnlyList<TItem>? Items { get; set; }

    /// <summary>The id of an item: the row key the element reports (<c>pk-row-click</c>, selection, expansion) and the name of the row's slots. Without it the row's index is the id, which is only stable while the list keeps its order. Ids must not contain a double quote.</summary>
    [Parameter] public Func<TItem, string>? IdOf { get; set; }

    /// <summary>The host sorts, filters and pages: the element shows <see cref="Items"/> exactly as given and only reports the user's sort and filter (<see cref="OnSort"/>, <see cref="OnFilter"/>). Set it whenever you load one page at a time.</summary>
    [Parameter] public bool Manual { get; set; }

    /// <summary>The key of the column the table is sorted by (two-way: <c>@bind-Sort</c>). Null or empty means no column.</summary>
    [Parameter] public string? Sort { get; set; }

    /// <summary>The sort direction; null leaves the element's default (ascending).</summary>
    [Parameter] public PkSortDirection? SortDirection { get; set; }

    /// <summary>Text per column key that the rows are filtered by (two-way: <c>@bind-Filters</c>; the filter row needs <see cref="Filterable"/>).</summary>
    [Parameter] public Dictionary<string, string>? Filters { get; set; }

    /// <summary>The ids of the selected rows (two-way: <c>@bind-Selected</c>; the checkbox column needs <see cref="Selectable"/>).</summary>
    [Parameter] public IReadOnlyList<string>? Selected { get; set; }

    /// <summary>The ids of the expanded rows (two-way: <c>@bind-Expanded</c>; needs <see cref="Expandable"/> and a <see cref="DetailTemplate"/>).</summary>
    [Parameter] public IReadOnlyList<string>? Expanded { get; set; }

    /// <summary>A checkbox column with select-all.</summary>
    [Parameter] public bool Selectable { get; set; }

    /// <summary>Rows are activatable: they show a pointer and raise <see cref="OnRowClick"/>. Each row is a keyboard stop (Enter or Space activates it).</summary>
    [Parameter] public bool Clickable { get; set; }

    /// <summary>The id of the row whose record is open in a detail pane: it is tinted and marked <c>aria-current</c>. Set it from the route; the table never changes it (there is no event for it).</summary>
    [Parameter] public string? CurrentRow { get; set; }

    /// <summary>A filter input under each header.</summary>
    [Parameter] public bool Filterable { get; set; }

    /// <summary>Rows get a toggle that shows their <see cref="DetailTemplate"/> under them.</summary>
    [Parameter] public bool Expandable { get; set; }

    /// <summary>Show a placeholder row instead of the rows, announce Loading and mark the table busy.</summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>The text shown when there are no rows; <see cref="EmptyContent"/> replaces it. Null leaves the element's own text.</summary>
    [Parameter] public string? EmptyText { get; set; }

    /// <summary>Each row becomes a card below 640px.</summary>
    [Parameter] public bool Cards { get; set; }

    /// <summary>Alternate row tint.</summary>
    [Parameter] public bool Striped { get; set; }

    /// <summary>Tint the row under the pointer.</summary>
    [Parameter] public bool Hover { get; set; }

    /// <summary>Border on every cell.</summary>
    [Parameter] public bool Bordered { get; set; }

    /// <summary>The cell padding step; null leaves the element's default.</summary>
    [Parameter] public PkTableDensity? Density { get; set; }

    /// <summary>Pin the header row (give the table a <see cref="MaxHeight"/>).</summary>
    [Parameter] public bool StickyHeader { get; set; }

    /// <summary>Pin the first column.</summary>
    [Parameter] public bool StickyColumn { get; set; }

    /// <summary>Bounds the scrolling frame (a CSS length, for example <c>24rem</c>); sticky header and column need it.</summary>
    [Parameter] public string? MaxHeight { get; set; }

    /// <summary>The table caption, as text.</summary>
    [Parameter] public string? Caption { get; set; }

    /// <summary>The accessible name of the table's scrolling region. Give every table one.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>No scroll frame, for a table inside a container that already scrolls.</summary>
    [Parameter] public bool Flow { get; set; }

    /// <summary>Search, filters and buttons above the table (the element's <c>toolbar</c> slot; rendered in a <c>pk-cluster</c>).</summary>
    [Parameter] public RenderFragment? ToolbarContent { get; set; }

    /// <summary>Actions shown while rows are selected (the <c>bulk</c> slot).</summary>
    [Parameter] public RenderFragment? BulkContent { get; set; }

    /// <summary>A caption with markup (the <c>caption</c> slot).</summary>
    [Parameter] public RenderFragment? CaptionContent { get; set; }

    /// <summary>The empty state, for example a <c>PkEmptyState</c> (the <c>empty</c> slot). It replaces <see cref="EmptyText"/>.</summary>
    [Parameter] public RenderFragment? EmptyContent { get; set; }

    /// <summary>Below the table (the <c>footer</c> slot): put a <c>PkPagination</c> here.</summary>
    [Parameter] public RenderFragment? FooterContent { get; set; }

    /// <summary>The detail of one row, shown under it when the user expands it (the element's <c>detail-&lt;rowId&gt;</c> slot). Needs <see cref="Expandable"/>.</summary>
    [Parameter] public RenderFragment<TItem>? DetailTemplate { get; set; }

    /// <summary>The user chose a sortable header: <c>Key</c> and <c>Direction</c> (<c>ascending</c> or <c>descending</c>). <see cref="Sort"/> and <see cref="SortDirection"/> already follow it. In manual mode, load the rows in that order.</summary>
    [Parameter] public EventCallback<PkSortEventArgs> OnSort { get; set; }

    /// <summary>A filter input changed (debounced by the element): <c>Filters</c> holds the text per column key.</summary>
    [Parameter] public EventCallback<PkFilterEventArgs> OnFilter { get; set; }

    /// <summary>The selection changed: <c>Selected</c> holds the ids.</summary>
    [Parameter] public EventCallback<PkSelectEventArgs> OnSelect { get; set; }

    /// <summary>A row of a <see cref="Clickable"/> table was activated: its id and item.</summary>
    [Parameter] public EventCallback<PkTableRowClickArgs<TItem>> OnRowClick { get; set; }

    /// <summary>The user expanded or collapsed a row: its id, item and the new state. <see cref="Expanded"/> already follows it.</summary>
    [Parameter] public EventCallback<PkTableRowExpandArgs<TItem>> OnRowExpand { get; set; }

    /// <summary>Raised with the new value of Sort (two-way: Sort follows it).</summary>
    [Parameter] public EventCallback<string?> SortChanged { get; set; }

    /// <summary>Raised with the new value of SortDirection (two-way: SortDirection follows it).</summary>
    [Parameter] public EventCallback<PkSortDirection?> SortDirectionChanged { get; set; }

    /// <summary>Raised with the new value of Filters (two-way: Filters follows it).</summary>
    [Parameter] public EventCallback<Dictionary<string, string>?> FiltersChanged { get; set; }

    /// <summary>Raised with the new value of Selected (two-way: Selected follows it).</summary>
    [Parameter] public EventCallback<IReadOnlyList<string>?> SelectedChanged { get; set; }

    /// <summary>Raised with the new value of Expanded (two-way: Expanded follows it).</summary>
    [Parameter] public EventCallback<IReadOnlyList<string>?> ExpandedChanged { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        var columns = Columns ?? [];
        var items = Items ?? [];
        _cells = columns.Where(c => c.Cell is not null).ToList();
        _columns = PkAttr.Json(columns.Select(c => c.ToColumn()).ToList())!;

        _items = new List<Row>(items.Count);
        _byId.Clear();
        var rows = new JsonArray();
        for (var i = 0; i < items.Count; i++)
        {
            var item = items[i];
            var id = IdOf?.Invoke(item) ?? i.ToString(CultureInfo.InvariantCulture);
            var node = PkTableRows.Serialize(item, columns);
            node["id"] = id;
            rows.Add(node);
            _items.Add(new Row(id, item));
            _byId.TryAdd(id, item);
        }
        _rows = PkTableRows.ToJson(rows);
    }

    /// <inheritdoc />
    protected override void AddEventHandlers(Dictionary<string, object> handlers)
    {
        handlers["onpk-sort"] = EventCallback.Factory.Create<PkSortEventArgs>(this, HandleSort);
        handlers["onpk-filter"] = EventCallback.Factory.Create<PkFilterEventArgs>(this, HandleFilter);
        handlers["onpk-select"] = EventCallback.Factory.Create<PkSelectEventArgs>(this, HandleSelect);
        handlers["onpk-row-click"] = EventCallback.Factory.Create<PkRowClickEventArgs>(this, HandleRowClick);
        handlers["onpk-row-expand"] = EventCallback.Factory.Create<PkRowExpandEventArgs>(this, HandleRowExpand);
    }

    private async Task HandleSort(PkSortEventArgs e)
    {
        // The element commits a sort by key; an empty key would mean "no sort" (the element does not send one today).
        Sort = string.IsNullOrEmpty(e.Key) ? null : e.Key;
        SortDirection = e.Direction == "descending" ? PkSortDirection.Descending : PkSortDirection.Ascending;
        await SortChanged.InvokeAsync(Sort);
        await SortDirectionChanged.InvokeAsync(SortDirection);
        await OnSort.InvokeAsync(e);
    }

    private async Task HandleFilter(PkFilterEventArgs e)
    {
        Filters = e.Filters ?? new Dictionary<string, string>();
        await FiltersChanged.InvokeAsync(Filters);
        await OnFilter.InvokeAsync(e);
    }

    private async Task HandleSelect(PkSelectEventArgs e)
    {
        // pk-select also bubbles up from menus, calendars and trees in the table's own slots: only the table's carries "selected".
        if (e.Selected is null) return;
        Selected = e.Selected;
        await SelectedChanged.InvokeAsync(Selected);
        await OnSelect.InvokeAsync(e);
    }

    private async Task HandleRowClick(PkRowClickEventArgs e)
    {
        if (e.Id is null || !_byId.TryGetValue(e.Id, out var item)) return;
        await OnRowClick.InvokeAsync(new PkTableRowClickArgs<TItem>(e.Id, item));
    }

    private async Task HandleRowExpand(PkRowExpandEventArgs e)
    {
        if (e.Id is null) return;
        var open = (Expanded ?? []).Where(x => x != e.Id).ToList();
        var expanded = e.Expanded == true;
        if (expanded) open.Add(e.Id);
        Expanded = open;
        await ExpandedChanged.InvokeAsync(Expanded);
        if (_byId.TryGetValue(e.Id, out var item)) await OnRowExpand.InvokeAsync(new PkTableRowExpandArgs<TItem>(e.Id, item, expanded));
    }
}
