@namespace PlainKit.Blazor.Components
@inherits PkElementBase

@* Hand-written (blazor/mappings/page-header.json marks it "existing"): the top of a page over <pk-page-header>. The title is a slotted <pk-heading> (a real heading element with tabindex -1, so a router can focus it after navigation:
   FocusOnNavigate Selector="pk-heading[level='1']", #773) and the typed list of crumbs goes down as the element's crumbs attribute (JSON); the element draws the breadcrumb, home crumb and back link itself (#801). *@
<pk-page-header heading="@Title"
                level="@PkAttr.Num(Level)"
                variant="@Variant"
                spacious="@Spacious"
                crumbs="@(HasCrumbs ? PkAttr.Json(Crumbs!.Select(c => new { c.Label, c.Href })) : null)"
                breadcrumb-label="@BreadcrumbLabel"
                home-href="@HomeHref"
                home-label="@HomeLabel"
                home-icon="@HomeIcon"
                back-link="@BackLink"
                class="@Css()"
                @attributes="Splat">@if (!string.IsNullOrEmpty(Title)) {<pk-heading slot="title" level="@PkAttr.Num(Level)" weight="semibold" variant="h3" tabindex="-1">@Title</pk-heading>}@SuffixContent@if (!HasCrumbs && BreadcrumbContent is not null) {<span slot="breadcrumb" class="u-contents">@BreadcrumbContent</span>}@if (ActionsContent is not null) {<span slot="actions" class="u-contents">@ActionsContent</span>}@if (MetaContent is not null) {<span slot="meta" class="u-contents">@MetaContent</span>}@if (TabsContent is not null) {<span slot="tabs" class="u-contents">@TabsContent</span>}</pk-page-header>

@code {
    /// <summary>
    /// The page title. Leave it off and the title is the label of the last crumb; set it for a page whose name is dynamic (a record's name).
    /// </summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>The trail from the section down to the current page, as a list of <see cref="PkCrumb"/>: every crumb but the last links, and the last one carries <c>aria-current="page"</c>. The app looks the route up; this only draws it.</summary>
    [Parameter] public IReadOnlyList<PkCrumb>? Crumbs { get; set; }

    /// <summary>The accessible name of the breadcrumb landmark.</summary>
    [Parameter] public string BreadcrumbLabel { get; set; } = "Breadcrumb";

    /// <summary>
    /// Draw a back link to the parent page: the last crumb before the current one that has an <c>Href</c> (a crumb without an address is skipped; without one there is no link). It is a real link
    /// (a ghost <c>PkButton</c> with a chevron, <c>Href</c> and the name <c>Back to &lt;crumb label&gt;</c>) drawn just above the header.
    /// Off by default because the app shell can draw its own (<c>back-href</c> and <c>back-label</c> on <c>PkAppShell</c>, which the layout owns and this header cannot reach): turn this on when the layout does not.
    /// </summary>
    [Parameter] public bool BackLink { get; set; }

    /// <summary>The heading level the title exposes to assistive technology (<c>aria-level</c>). 1 by default: this is the page's title.</summary>
    [Parameter] public int Level { get; set; } = 1;

    /// <summary>page is the standard page top; section is a titled section inside a page (title, actions, note); record is the compact strip of a single-record page (chips on the left, actions right). Left off, the element's own default applies.</summary>
    [Parameter] public string? Variant { get; set; }

    /// <summary>
    /// Without an explicit <see cref="Title"/> (the last crumb doubles as the title), pk-page-header collapses the crumbs, the default-slot content and the actions onto a single row by
    /// default, for every variant. Set Spacious to opt back into the older multi-row breakdown (a breadcrumb row, then a title bar with actions, then the note line) for a title too long
    /// to share a row with the actions, or more badges than fit one row. Has no effect when Title is set: a real title always keeps its own row above the crumbs.
    /// </summary>
    [Parameter] public bool Spacious { get; set; }

    /// <summary>Beside the title: a status chip, a count or a badge.</summary>
    [Parameter] public RenderFragment? SuffixContent { get; set; }

    /// <summary>Your own trail in the <c>breadcrumb</c> slot, used only when <see cref="Crumbs"/> is not set.</summary>
    [Parameter] public RenderFragment? BreadcrumbContent { get; set; }

    /// <summary>Buttons at the right of the title bar; full width and touch-sized on a narrow container.</summary>
    [Parameter] public RenderFragment? ActionsContent { get; set; }

    /// <summary>A note or metadata line under the title bar.</summary>
    [Parameter] public RenderFragment? MetaContent { get; set; }

    /// <summary>A tab strip docked at the foot of the header (a <c>PkTabs</c> with tabs only): with the header sticky it stays in view with the bar.</summary>
    [Parameter] public RenderFragment? TabsContent { get; set; }

    /// <summary>An address for a leading home crumb: an icon-only link (named by <see cref="HomeLabel"/>) first in the trail <see cref="Crumbs"/> draws. Null (the default) draws none.</summary>
    [Parameter] public string? HomeHref { get; set; }

    /// <summary>The accessible name of the home crumb.</summary>
    [Parameter] public string HomeLabel { get; set; } = "Home";

    /// <summary>The icon of the home crumb.</summary>
    [Parameter] public string HomeIcon { get; set; } = "dashboard";

    private bool HasCrumbs => Crumbs is { Count: > 0 };
}
