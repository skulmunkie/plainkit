@namespace PlainKit.Blazor
@inherits PkElementBase

@* Hand-written (blazor/mappings/card.json marks it "existing"): a titled panel over <pk-card>. Parameters are attributes, slots are fragments. *@
<pk-card heading="@Heading"
         level="@PkAttr.Num(Level)"
         tone="@Tone"
         orientation="@Orientation"
         flush="@Flush"
         href="@Href"
         fill="@Fill"
         class="@Css()"
         @attributes="Splat">@ChildContent@if (MediaContent is not null) {<span slot="media" class="u-contents">@MediaContent</span>}@if (ActionsContent is not null) {<span slot="actions" class="u-contents">@ActionsContent</span>}@if (FooterContent is not null) {<span slot="footer" class="u-contents">@FooterContent</span>}</pk-card>

@code {
    /// <summary>The card's title.</summary>
    [Parameter] public string? Heading { get; set; }

    /// <summary>The heading level (h1 to h6) of the title, 2 by default.</summary>
    [Parameter] public int Level { get; set; } = 2;

    /// <summary>The tone: <c>default</c> or <c>error</c>. Left off, the element's own default applies.</summary>
    [Parameter] public string? Tone { get; set; }

    /// <summary>The layout: <c>vertical</c> or <c>horizontal</c>. Left off, the element's own default applies.</summary>
    [Parameter] public string? Orientation { get; set; }

    /// <summary>Removes the body padding, for a table or list that fills the card.</summary>
    [Parameter] public bool Flush { get; set; }

    /// <summary>Makes the whole card one link to this address.</summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>The card fills the height of its container.</summary>
    [Parameter] public bool Fill { get; set; }

    /// <summary>The card body.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The media slot (an image or a chart above or beside the body).</summary>
    [Parameter] public RenderFragment? MediaContent { get; set; }

    /// <summary>The header actions slot.</summary>
    [Parameter] public RenderFragment? ActionsContent { get; set; }

    /// <summary>The footer slot.</summary>
    [Parameter] public RenderFragment? FooterContent { get; set; }
}
