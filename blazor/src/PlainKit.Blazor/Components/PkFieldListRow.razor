@namespace PlainKit.Blazor

@* Hand-written, no element of its own (issue 207): one dt/dd pair for a PkFieldList that can hide itself. PkFieldList's own slot just
   takes raw dt and dd (see PkFieldList.razor); this composes the "should this row even show up" decision that every consumer of an
   optional term/value pair was re-deriving by hand with an @if around a wrapper. Not named PkField: that name is already the generated
   wrapper for the pk-field form-layout element (label/help/error around a control), an unrelated concept. *@
@if (Visible)
{
    <dt>@Label</dt>
    <dd>@if (ChildContent is not null) { @ChildContent } else { @Value }</dd>
}

@code {
    /// <summary>The term (the row's <c>dt</c>).</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>The value as plain text. Mutually exclusive with <see cref="ChildContent"/>; when both are set, <see cref="ChildContent"/> wins.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>The value as rich content (a badge, a link, formatted code). Mutually exclusive with <see cref="Value"/>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Omit the row when there is no plain <see cref="Value"/> and no <see cref="ChildContent"/>. Default <c>true</c>; ignored when <see cref="When"/> is set.</summary>
    [Parameter] public bool SkipEmpty { get; set; } = true;

    /// <summary>Explicit visibility, independent of whether a value is present. When set (non-null) it wins outright over <see cref="SkipEmpty"/>:
    /// <c>true</c> renders the row even with nothing to show, <c>false</c> hides it even with a value present. Left <c>null</c>, visibility
    /// falls back to <see cref="SkipEmpty"/> against whether <see cref="Value"/> or <see cref="ChildContent"/> is present.</summary>
    [Parameter] public bool? When { get; set; }

    private bool HasContent => ChildContent is not null || !string.IsNullOrEmpty(Value);

    private bool Visible => When ?? (!SkipEmpty || HasContent);
}
