@namespace PlainKit.Blazor
@inherits PkElementBase

@* Hand-written (blazor/mappings/field-list.json marks it "existing"): a titled description list over <pk-field-list>. Put dt and dd pairs
   in the content, or set Items for data-driven rows (issue 527) — both render together; an Items row with an empty Value hides itself
   unless ShowEmpty is set (issue 207, already covered for the ChildContent form by PkFieldListRow). *@
<pk-field-list heading="@Title"
               layout="@Layout"
               dividers="@Dividers"
               dense="@Dense"
               items="@PkAttr.Json(Items)"
               show-empty="@ShowEmpty"
               class="@Css()"
               @attributes="Splat">@ChildContent</pk-field-list>

@code {
    /// <summary>The list's title (the element's <c>heading</c>).</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>The layout: <c>grid</c> (term beside value) or <c>stacked</c>. Left off, the element's own default applies.</summary>
    [Parameter] public string? Layout { get; set; }

    /// <summary>Draws a rule between the pairs.</summary>
    [Parameter] public bool Dividers { get; set; }

    /// <summary>Tighter spacing.</summary>
    [Parameter] public bool Dense { get; set; }

    /// <summary>Data-driven rows, rendered alongside any <see cref="ChildContent"/> dt/dd pairs. <see cref="PkFieldListItem.Value"/> is text
    /// only; a rich value still uses <see cref="ChildContent"/> (raw dt/dd, or <see cref="PkFieldListRow"/> for the skip-when-empty behaviour).</summary>
    [Parameter] public IReadOnlyList<PkFieldListItem>? Items { get; set; }

    /// <summary>Shows an <see cref="Items"/> row whose value is empty instead of hiding it.</summary>
    [Parameter] public bool ShowEmpty { get; set; }

    /// <summary>The term and value pairs: slotted <c>dt</c> and <c>dd</c> elements.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
