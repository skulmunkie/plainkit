@* Generated by scripts/generate-blazor.mjs from core/dist/elements/api.json and blazor/mappings/image-gallery.json. Do not edit: change the mapping or the SDK and run it again. *@
@namespace PlainKit.Blazor
@using Microsoft.AspNetCore.Components.Web
@inherits PkElementBase

<pk-image-gallery images="@PkAttr.Json(Images)"
                  primary="@PkAttr.Num(Primary)"
                  columns="@PkAttr.Num(Columns)"
                  min="@Min"
                  editable="@Editable"
                  add-label="@AddLabel"
                  accept="@Accept"
                  class="@Css()"
                  @attributes="Splat"></pk-image-gallery>

@code {
    /// <summary>The images: [{ src, alt, primary?, status? }]. status is a short warning badge such as Staged. Property or a JSON attribute. Only same-site paths, http(s) and raster data URLs are shown.</summary>
    [Parameter] public object? Images { get; set; }

    /// <summary>The index of the primary image; -1 uses the first image flagged primary in images, or none.</summary>
    [Parameter] public int Primary { get; set; } = -1;

    /// <summary>Raised when Primary changes (two-way binding: &lt;c&gt;@bind-Primary&lt;/c&gt;).</summary>
    [Parameter] public EventCallback<int> PrimaryChanged { get; set; }

    /// <summary>A fixed number of equal columns (1 to 12). 0 fits as many as min allows.</summary>
    [Parameter] public int Columns { get; set; } = 0;

    /// <summary>The narrowest a thumbnail may get, as a css length in px, rem or em. Used when columns is 0.</summary>
    [Parameter] public string? Min { get; set; } = "6.25rem";

    /// <summary>Show make-primary and remove buttons under each image and the add tile.</summary>
    [Parameter] public bool Editable { get; set; }

    /// <summary>Text on the add tile.</summary>
    [Parameter] public string? AddLabel { get; set; } = "Add image";

    /// <summary>The file types the add tile's picker offers.</summary>
    [Parameter] public string? Accept { get; set; } = "image/*";

    /// <summary>Make primary was pressed. Cancelable: preventDefault keeps the current primary (a controlled gallery updates images and primary itself).</summary>
    [Parameter] public EventCallback<PkPrimaryChangeEventArgs> OnPrimaryChange { get; set; }

    /// <summary>Remove was pressed. Cancelable: preventDefault keeps the image. Otherwise it is taken out of images, and if it was the primary the first image becomes the primary.</summary>
    [Parameter] public EventCallback<PkRemoveEventArgs> OnRemove { get; set; }

    /// <summary>Files were chosen on the add tile. The gallery adds nothing itself: read the files (a data URL) and set images.</summary>
    [Parameter] public EventCallback<PkAddEventArgs> OnAdd { get; set; }

    /// <inheritdoc />
    protected override void AddEventHandlers(Dictionary<string, object> handlers)
    {
        handlers["onpk-primary-change"] = EventCallback.Factory.Create<PkPrimaryChangeEventArgs>(this, HandlePkPrimaryChange);
        handlers["onpk-remove"] = EventCallback.Factory.Create<PkRemoveEventArgs>(this, HandlePkRemove);
        handlers["onpk-add"] = EventCallback.Factory.Create<PkAddEventArgs>(this, HandlePkAdd);
    }

    private async Task HandlePkPrimaryChange(PkPrimaryChangeEventArgs e)
    {
        Primary = (int)(e.Index ?? 0);
        await PrimaryChanged.InvokeAsync(Primary);
        await OnPrimaryChange.InvokeAsync(e);
    }

    private async Task HandlePkRemove(PkRemoveEventArgs e)
    {
        await OnRemove.InvokeAsync(e);
    }

    private async Task HandlePkAdd(PkAddEventArgs e)
    {
        await OnAdd.InvokeAsync(e);
    }
}
