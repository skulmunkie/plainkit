@* Generated by scripts/generate-blazor.mjs from core/dist/elements/api.json and blazor/mappings/popover.json. Do not edit: change the mapping or the SDK and run it again. *@
@namespace PlainKit.Blazor
@using Microsoft.AspNetCore.Components.Web
@inherits PkElementBase

<pk-popover open="@Open"
            placement="@Placement"
            trigger="@(Trigger.ToAttr())"
            heading="@Heading"
            label="@Label"
            variant="@(Variant.ToAttr())"
            message="@Message"
            confirm-label="@ConfirmLabel"
            cancel-label="@CancelLabel"
            danger="@Danger"
            class="@Css()"
            @attributes="Splat">@if (TriggerContent is not null) {<span slot="trigger">@TriggerContent</span>}@ChildContent</pk-popover>

@code {
    /// <summary>Whether the panel is shown.</summary>
    [Parameter] public bool Open { get; set; }

    /// <summary>Raised when Open changes (two-way binding: &lt;c&gt;@bind-Open&lt;/c&gt;).</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Preferred side.</summary>
    [Parameter] public string? Placement { get; set; } = "bottom-start";

    /// <summary>What opens it.</summary>
    [Parameter] public PopoverTrigger Trigger { get; set; } = PopoverTrigger.Click;

    /// <summary>Panel title.</summary>
    [Parameter] public string? Heading { get; set; } = "";

    /// <summary>Accessible name when there is no heading.</summary>
    [Parameter] public string? Label { get; set; } = "";

    /// <summary>confirm adds Cancel and Confirm buttons.</summary>
    [Parameter] public PopoverVariant Variant { get; set; } = PopoverVariant.Default;

    /// <summary>Body text for the confirm variant.</summary>
    [Parameter] public string? Message { get; set; } = "";

    /// <summary>Confirm button text.</summary>
    [Parameter] public string? ConfirmLabel { get; set; } = "Confirm";

    /// <summary>Cancel button text.</summary>
    [Parameter] public string? CancelLabel { get; set; } = "Cancel";

    /// <summary>Styles Confirm as destructive.</summary>
    [Parameter] public bool Danger { get; set; }

    /// <summary>The control that opens it.</summary>
    [Parameter] public RenderFragment? TriggerContent { get; set; }

    /// <summary>Panel body.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Panel opened.</summary>
    [Parameter] public EventCallback OnOpen { get; set; }

    /// <summary>Panel closed (escape, outside, cancel, confirm, toggle).</summary>
    [Parameter] public EventCallback<PkCloseEventArgs> OnClose { get; set; }

    /// <summary>Confirm pressed (variant confirm).</summary>
    [Parameter] public EventCallback OnConfirm { get; set; }

    /// <inheritdoc />
    protected override void AddEventHandlers(Dictionary<string, object> handlers)
    {
        handlers["onpk-close"] = EventCallback.Factory.Create<PkCloseEventArgs>(this, HandlePkClose);
        handlers["onpk-open"] = EventCallback.Factory.Create<EventArgs>(this, HandlePkOpen);
        handlers["onpk-confirm"] = EventCallback.Factory.Create<EventArgs>(this, HandlePkConfirm);
    }

    private async Task HandlePkClose(PkCloseEventArgs e)
    {
        Open = false;
        await OpenChanged.InvokeAsync(Open);
        await OnClose.InvokeAsync(e);
    }

    private async Task HandlePkOpen(EventArgs e)
    {
        await OnOpen.InvokeAsync();
    }

    private async Task HandlePkConfirm(EventArgs e)
    {
        await OnConfirm.InvokeAsync();
    }
}
