@namespace PlainKit.Blazor
@using Microsoft.AspNetCore.Components.Web
@inherits PkElementBase

<pk-hint label="@Label"
         open="@Open"
         tone="@Tone"
         @attributes="Splat">@ChildContent</pk-hint>

@code {
    /// <summary>The toggle text.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Expanded.</summary>
    [Parameter] public bool Open { get; set; }

    /// <summary>Accent colour.</summary>
    [Parameter] public string? Tone { get; set; }

    /// <summary>Raised with the new value of Open (two-way: Open follows it).</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>The explanation.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Dictionary<string, object> Splat { get; set; } = new();

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        Splat = new Dictionary<string, object>
        {
            ["onpk-toggle"] = EventCallback.Factory.Create<PkToggleEventArgs>(this, HandlePkToggle),
        };
    }

    private async Task HandlePkToggle(PkToggleEventArgs e)
    {
        Open = e.Open == true;
        await OpenChanged.InvokeAsync(Open);
    }
}
