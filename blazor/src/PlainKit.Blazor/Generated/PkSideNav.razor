@namespace PlainKit.Blazor
@using Microsoft.AspNetCore.Components.Web
@inherits PkElementBase

<pk-side-nav label="@Label"
             collapsed="@Collapsed"
             open="@Open"
             filterable="@Filterable"
             persist="@Persist"
             @attributes="Splat">@if (BrandContent is not null) {<span slot="brand">@BrandContent</span>}@ChildContent@if (FooterContent is not null) {<span slot="footer">@FooterContent</span>}</pk-side-nav>

@code {
    /// <summary>Accessible name</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Icon rail.</summary>
    [Parameter] public bool Collapsed { get; set; }

    /// <summary>Raised when Collapsed changes (two-way binding: &lt;c&gt;@bind-Collapsed&lt;/c&gt;).</summary>
    [Parameter] public EventCallback<bool> CollapsedChanged { get; set; }

    /// <summary>Drawer open (phones and tablets).</summary>
    [Parameter] public bool Open { get; set; }

    /// <summary>Raised when Open changes (two-way binding: &lt;c&gt;@bind-Open&lt;/c&gt;).</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Show the filter box.</summary>
    [Parameter] public bool Filterable { get; set; }

    /// <summary>localStorage key for collapsed and open branches.</summary>
    [Parameter] public string? Persist { get; set; }

    /// <summary>Brand link.</summary>
    [Parameter] public RenderFragment? BrandContent { get; set; }

    /// <summary>pk-nav-item children.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Pinned bottom items.</summary>
    [Parameter] public RenderFragment? FooterContent { get; set; }

    /// <summary>Rail toggled.</summary>
    [Parameter] public EventCallback<bool> OnToggle { get; set; }

    private Dictionary<string, object> Splat { get; set; } = new();

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        Splat = new Dictionary<string, object>
        {
            ["onpk-nav-toggle"] = EventCallback.Factory.Create<PkNavToggleEventArgs>(this, HandlePkNavToggle),
            ["onpk-close"] = EventCallback.Factory.Create<PkCloseEventArgs>(this, HandlePkClose),
        };
    }

    private async Task HandlePkNavToggle(PkNavToggleEventArgs e)
    {
        Collapsed = e.Collapsed == true;
        await CollapsedChanged.InvokeAsync(Collapsed);
        await OnToggle.InvokeAsync(e.Collapsed == true);
    }

    private async Task HandlePkClose(PkCloseEventArgs e)
    {
        Open = false;
        await OpenChanged.InvokeAsync(Open);
    }
