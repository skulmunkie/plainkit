@* Generated by scripts/generate-blazor.mjs from core/dist/elements/api.json and blazor/mappings/rating.json. Do not edit: change the mapping or the SDK and run it again. *@
@namespace PlainKit.Blazor
@using Microsoft.AspNetCore.Components.Web
@inherits PkElementBase

<pk-rating value="@PkAttr.Num(Value)"
           max="@PkAttr.Num(Max)"
           readonly="@ReadOnly"
           label="@Label"
           disabled="@Disabled"
           class="@Css()"
           @attributes="Splat"></pk-rating>

@code {
    /// <summary>The rating, 0 for none. A form reset sets it back to its initial value without raising the commit event, as a native control does: pk-form raises pk-reset after it, so a host that mirrors the value reads it again there. A browser state restore also sets it silently.</summary>
    [Parameter] public int Value { get; set; } = 0;

    /// <summary>Number of stars.</summary>
    [Parameter] public int Max { get; set; } = 5;

    /// <summary>The display form: not interactive, exposed as an image with a text alternative.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>The accessible name (aria-label). pk-field fills it from its own label when this is empty.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Blocks interaction; also set by a disabled fieldset.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Raised when Value changes (two-way binding: &lt;c&gt;@bind-Value&lt;/c&gt;).</summary>
    [Parameter] public EventCallback<int> ValueChanged { get; set; }

    /// <inheritdoc />
    protected override void AddEventHandlers(Dictionary<string, object> handlers)
    {
        handlers["onpk-rating-change"] = EventCallback.Factory.Create<PkRatingChangeEventArgs>(this, HandlePkRatingChange);
    }

    private async Task HandlePkRatingChange(PkRatingChangeEventArgs e)
    {
        Value = (int)(e.Value ?? 0);
        await ValueChanged.InvokeAsync(Value);
    }
}
