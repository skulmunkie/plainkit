@* Generated by scripts/generate-blazor.mjs from core/dist/elements/api.json and blazor/mappings/select-menu.json. Do not edit: change the mapping or the SDK and run it again. *@
@namespace PlainKit.Blazor
@using Microsoft.AspNetCore.Components.Web
@inherits PkElementBase

<pk-select-menu value="@Value"
                name="@Name"
                placeholder="@Placeholder"
                open="@Open"
                disabled="@Disabled"
                required="@Required"
                class="@Css()"
                @attributes="Splat">@ChildContent</pk-select-menu>

@code {
    /// <summary>Selected option value. A form reset sets it back to its initial value without raising the commit event, as a native control does: pk-form raises pk-reset after it, so a host that mirrors the value reads it again there. A browser state restore also sets it silently.</summary>
    [Parameter] public string? Value { get; set; } = "";

    /// <summary>Raised when Value changes (two-way binding: &lt;c&gt;@bind-Value&lt;/c&gt;).</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Form field name.</summary>
    [Parameter] public string? Name { get; set; } = "";

    /// <summary>Shown with no selection.</summary>
    [Parameter] public string? Placeholder { get; set; } = "Select…";

    /// <summary>Whether the list is shown.</summary>
    [Parameter] public bool Open { get; set; }

    /// <summary>Prevents interaction</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>A value is required</summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>option elements.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The selection changed.</summary>
    [Parameter] public EventCallback<PkChangeEventArgs> OnChange { get; set; }

    /// <inheritdoc />
    protected override void AddEventHandlers(Dictionary<string, object> handlers)
    {
        handlers["onpk-change"] = EventCallback.Factory.Create<PkChangeEventArgs>(this, HandlePkChange);
    }

    private async Task HandlePkChange(PkChangeEventArgs e)
    {
        Value = e.Value;
        await ValueChanged.InvokeAsync(Value);
        await OnChange.InvokeAsync(e);
    }
}
