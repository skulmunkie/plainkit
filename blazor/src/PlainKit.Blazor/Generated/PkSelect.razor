@namespace PlainKit.Blazor
@using Microsoft.AspNetCore.Components.Web
@inherits PkElementBase

<pk-select value="@Value"
           disabled="@Disabled"
           required="@Required"
           label="@Label"
           invalid="@IsInvalid"
           multiple="@Multiple"
           class="@Css()"
           @attributes="Splat">@ChildContent</pk-select>

@code {
    /// <summary>The current value; what the form submits. A form reset sets it back to its initial value without raising the commit event, as a native control does: pk-form raises pk-reset after it, so a host that mirrors the value reads it again there. A browser state restore also sets it silently.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Blocks interaction; also set by a disabled fieldset.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>The form cannot be submitted while the value is empty.</summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>The accessible name (aria-label). pk-field fills it from its own label when this is empty.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Shows the invalid state and sets aria-invalid; set by pk-field or pk-form (or by a Blazor EditContext).</summary>
    [Parameter] public bool IsInvalid { get; set; }

    /// <summary>Allows several selections (value is comma-separated; the form submits one entry each).</summary>
    [Parameter] public bool Multiple { get; set; }

    /// <summary>option and optgroup elements.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Raised when Value changes (two-way binding: &lt;c&gt;@bind-Value&lt;/c&gt;).</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <inheritdoc />
    protected override void AddEventHandlers(Dictionary<string, object> handlers)
    {
        handlers["onpk-value-change"] = EventCallback.Factory.Create<PkValueChangeEventArgs>(this, HandlePkValueChange);
    }

    private async Task HandlePkValueChange(PkValueChangeEventArgs e)
    {
        Value = e.Value;
        await ValueChanged.InvokeAsync(Value);
    }
}
