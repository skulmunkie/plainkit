@* Generated by scripts/generate-blazor.mjs from core/dist/elements/api.json and blazor/mappings/splitter.json. Do not edit: change the mapping or the SDK and run it again. *@
@namespace PlainKit.Blazor
@using Microsoft.AspNetCore.Components.Web
@inherits PkElementBase

<pk-splitter orientation="@Orientation"
             size="@PkAttr.Num(Size)"
             min="@PkAttr.Num(Min)"
             max="@PkAttr.Num(Max)"
             step="@PkAttr.Num(Step)"
             label="@AriaLabel"
             disabled="@Disabled"
             @attributes="Splat">@if (StartContent is not null) {<span slot="start">@StartContent</span>}@if (EndContent is not null) {<span slot="end">@EndContent</span>}</pk-splitter>

@code {
    /// <summary>How the panes lie: horizontal puts them side by side (the separator is a vertical bar), vertical stacks them (the separator is a horizontal bar and it is 16rem tall unless --pk-splitter-height says otherwise).</summary>
    [Parameter] public string? Orientation { get; set; } = "horizontal";

    /// <summary>The start pane's share of the room, in percent, kept between min and max. While the user drags or presses a key the element owns it; after pk-resize the host does.</summary>
    [Parameter] public double Size { get; set; } = 50;

    /// <summary>Raised when Size changes (two-way binding: &lt;c&gt;@bind-Size&lt;/c&gt;).</summary>
    [Parameter] public EventCallback<double> SizeChanged { get; set; }

    /// <summary>Smallest size of the start pane, in percent (aria-valuemin).</summary>
    [Parameter] public double Min { get; set; } = 10;

    /// <summary>Largest size of the start pane, in percent (aria-valuemax).</summary>
    [Parameter] public double Max { get; set; } = 90;

    /// <summary>Percent moved by one arrow key press.</summary>
    [Parameter] public double Step { get; set; } = 2;

    /// <summary>The separator's accessible name (aria-label).</summary>
    [Parameter] public string? AriaLabel { get; set; } = "Resize panes";

    /// <summary>Fixes the size: the separator no longer takes focus or moves.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>The first pane (left, or top when stacked); its size is size percent.</summary>
    [Parameter] public RenderFragment? StartContent { get; set; }

    /// <summary>The second pane, which takes the rest.</summary>
    [Parameter] public RenderFragment? EndContent { get; set; }

    private Dictionary<string, object> Splat { get; set; } = new();

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        Splat = new Dictionary<string, object>
        {
            ["onpk-resize"] = EventCallback.Factory.Create<PkResizeEventArgs>(this, HandlePkResize),
        };
    }

    private async Task HandlePkResize(PkResizeEventArgs e)
    {
        Size = e.Size ?? 0;
        await SizeChanged.InvokeAsync(Size);
    }
}
