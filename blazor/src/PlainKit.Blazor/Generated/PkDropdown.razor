@namespace PlainKit.Blazor
@using Microsoft.AspNetCore.Components.Web
@inherits PkElementBase

<pk-dropdown open="@Open"
             placement="@Placement"
             keep-open="@KeepOpen"
             mega="@Mega"
             class="@Css()"
             @attributes="Splat">@if (TriggerContent is not null) {<span slot="trigger">@TriggerContent</span>}@ChildContent</pk-dropdown>

@code {
    /// <summary>Whether the menu is shown.</summary>
    [Parameter] public bool Open { get; set; }

    /// <summary>Raised when Open changes (two-way binding: &lt;c&gt;@bind-Open&lt;/c&gt;).</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Preferred side.</summary>
    [Parameter] public string? Placement { get; set; } = "bottom-start";

    /// <summary>Stay open after an item is chosen (multi-select filters).</summary>
    [Parameter] public bool KeepOpen { get; set; }

    /// <summary>A wide panel whose items flow into columns (navbar mega menu).</summary>
    [Parameter] public bool Mega { get; set; }

    /// <summary>The button that opens it.</summary>
    [Parameter] public RenderFragment? TriggerContent { get; set; }

    /// <summary>pk-menu-item children.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>An item was chosen.</summary>
    [Parameter] public EventCallback<PkSelectEventArgs> OnSelect { get; set; }

    /// <summary>Opened.</summary>
    [Parameter] public EventCallback OnOpen { get; set; }

    /// <summary>Closed.</summary>
    [Parameter] public EventCallback<PkCloseEventArgs> OnClose { get; set; }

    /// <inheritdoc />
    protected override void AddEventHandlers(Dictionary<string, object> handlers)
    {
        handlers["onpk-close"] = EventCallback.Factory.Create<PkCloseEventArgs>(this, HandlePkClose);
        handlers["onpk-select"] = EventCallback.Factory.Create<PkSelectEventArgs>(this, HandlePkSelect);
        handlers["onpk-open"] = EventCallback.Factory.Create<EventArgs>(this, HandlePkOpen);
    }

    private async Task HandlePkClose(PkCloseEventArgs e)
    {
        Open = false;
        await OpenChanged.InvokeAsync(Open);
        await OnClose.InvokeAsync(e);
    }

    private async Task HandlePkSelect(PkSelectEventArgs e)
    {
        await OnSelect.InvokeAsync(e);
    }

    private async Task HandlePkOpen(EventArgs e)
    {
        await OnOpen.InvokeAsync();
    }
}
