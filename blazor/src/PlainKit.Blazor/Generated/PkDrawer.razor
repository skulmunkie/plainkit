@namespace PlainKit.Blazor
@using Microsoft.AspNetCore.Components.Web
@inherits PkElementBase

<pk-drawer open="@IsOpen"
           heading="@Title"
           persistent="@Persistent"
           wide="@Wide"
           docked="@Docked"
           class="@Css()"
           @attributes="Splat">@ChildContent@if (FooterContent is not null) {<span slot="footer">@FooterContent</span>}@if (ActionsContent is not null) {<span slot="actions">@ActionsContent</span>}</pk-drawer>

@code {
    /// <summary>Whether it is shown</summary>
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>Raised when IsOpen changes (two-way binding: &lt;c&gt;@bind-IsOpen&lt;/c&gt;).</summary>
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>Title; also the accessible name.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Body.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Actions.</summary>
    [Parameter] public RenderFragment? FooterContent { get; set; }

    /// <summary>Actions strip under the header (Save, Cancel).</summary>
    [Parameter] public RenderFragment? ActionsContent { get; set; }

    /// <summary>escape, backdrop, close button, swipe or method.</summary>
    [Parameter] public EventCallback<PkCloseEventArgs> OnClose { get; set; }

    /// <summary>The backdrop does not close it.</summary>
    [Parameter] public bool Persistent { get; set; }

    /// <summary>A wider panel (up to 70% of the viewport).</summary>
    [Parameter] public bool Wide { get; set; }

    /// <summary>A non-modal inspector: it sits inside the nearest positioned ancestor instead of the viewport, has no backdrop and no focus trap, and the page behind stays usable. Escape still asks to close.</summary>
    [Parameter] public bool Docked { get; set; }

    /// <inheritdoc />
    protected override void AddEventHandlers(Dictionary<string, object> handlers)
    {
        handlers["onpk-close"] = EventCallback.Factory.Create<PkCloseEventArgs>(this, HandlePkClose);
    }

    private async Task HandlePkClose(PkCloseEventArgs e)
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
        await OnClose.InvokeAsync(e);
    }
}
