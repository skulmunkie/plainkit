          align="@Align"
          dividers="@Dividers">@ChildContent</pk-stack>

@code {
    /// <summary>Space between children, on the spacing scale (none 0, xs --space-1, sm --space-2, md --space-4, lg --space-6, xl --space-8). Default md (the flow space).</summary>
    [Parameter] public string? Gap { get; set; }

    /// <summary>Cross-axis alignment: stretch fills the width, the others size each child to its content.</summary>
    [Parameter] public string? Align { get; set; }

