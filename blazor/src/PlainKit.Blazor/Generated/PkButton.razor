@* Generated by scripts/generate-blazor.mjs from core/dist/elements/api.json and blazor/mappings/button.json. Do not edit: change the mapping or the SDK and run it again. *@
@namespace PlainKit.Blazor
@using Microsoft.AspNetCore.Components.Web
@inherits PkElementBase

<pk-button variant="@(Variant?.ToAttr())"
           size="@(Size?.ToAttr())"
           type="@Type"
           disabled="@Disabled"
           busy="@Busy"
           busy-text="@BusyText"
           label="@AriaLabel"
           block="@Block"
           icon="@Icon"
           toggle="@Toggle"
           pressed="@Pressed"
           @onclick="HandleClick">@ChildContent@if (StartContent is not null) {<span slot="start">@StartContent</span>}@if (EndContent is not null) {<span slot="end">@EndContent</span>}</pk-button>

@code {
    /// <summary>Visual weight.</summary>
    [Parameter] public ButtonVariant? Variant { get; set; }

    /// <summary>md is the reading-size control; mini is the compact desktop-density one; lg is the large one.</summary>
    [Parameter] public ButtonSize? Size { get; set; }

    /// <summary>What a click does inside a form: nothing, submit it, or reset it.</summary>
    [Parameter] public string? Type { get; set; }

    /// <summary>Blocks interaction and dims the control. Also set by a disabled fieldset.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Shows a spinner and ignores clicks without disabling the button, so focus stays put.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>Replaces the label while busy.</summary>
    [Parameter] public string? BusyText { get; set; }

    /// <summary>An accessible name when the visible content is only an icon.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Fills the width of its container.</summary>
    [Parameter] public bool Block { get; set; }

    /// <summary>A square icon-only button (give it a label).</summary>
    [Parameter] public bool Icon { get; set; }

    /// <summary>A button that stays pressed: a click flips pressed.</summary>
    [Parameter] public bool Toggle { get; set; }

    /// <summary>The pressed state of a toggle button.</summary>
    [Parameter] public bool Pressed { get; set; }

    /// <summary>A click (not fired while disabled or busy).</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>The label.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>An icon before the label.</summary>
    [Parameter] public RenderFragment? StartContent { get; set; }

    /// <summary>An icon after the label.</summary>
    [Parameter] public RenderFragment? EndContent { get; set; }

    private async Task HandleClick(MouseEventArgs e)
    {
        await OnClick.InvokeAsync(e);
    }
}
