@* Generated by scripts/generate-blazor.mjs from core/dist/elements/api.json and blazor/mappings/icon.json. Do not edit: change the mapping or the SDK and run it again. *@
@namespace PlainKit.Blazor
@using Microsoft.AspNetCore.Components.Web
@inherits PkElementBase

<pk-icon name="@Name"
         size="@Size"
         label="@Label"
         class="@Css()"
         @attributes="Splat"></pk-icon>

@code {
    /// <summary>The symbol id in the sprite (search, settings, orders, ...).</summary>
    [Parameter] public string? Name { get; set; }

    /// <summary>md is 1.25em and follows the text; sm, lg and xl are fixed steps of the space scale.</summary>
    [Parameter] public string? Size { get; set; }

    /// <summary>The accessible name. Without it the icon is decorative and hidden from assistive technology.</summary>
    [Parameter] public string? Label { get; set; }
}
