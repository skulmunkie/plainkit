             @attributes="Splat">@ChildContent@if (IconContent is not null) {<span slot="icon">@IconContent</span>}@if (BadgeContent is not null) {<span slot="badge">@BadgeContent</span>}@if (ChildrenContent is not null) {<span slot="children">@ChildrenContent</span>}</pk-nav-item>

