@namespace PlainKit.Blazor
@using Microsoft.AspNetCore.Components.Web
@inherits PkElementBase

<pk-dialog open="@IsOpen"
           heading="@Title"
           hide-close="@(!ShowCloseButton)"
           class="@Css()"
           @attributes="Splat">@if (HeaderContent is not null) {<span slot="header">@HeaderContent</span>}@ChildContent@if (FooterContent is not null) {<span slot="footer">@FooterContent</span>}</pk-dialog>

@code {
    /// <summary>Whether it is shown</summary>
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>Raised when IsOpen changes (two-way binding: &lt;c&gt;@bind-IsOpen&lt;/c&gt;).</summary>
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>The heading setting</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Custom header.</summary>
    [Parameter] public RenderFragment? HeaderContent { get; set; }

    /// <summary>Body.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Actions.</summary>
    [Parameter] public RenderFragment? FooterContent { get; set; }

    /// <summary>escape, close button or method.</summary>
    [Parameter] public EventCallback<PkCloseEventArgs> OnClose { get; set; }

    /// <summary>Hide the header close button (the dialog offers its own Cancel in the footer).</summary>
    /// <remarks>False hides the header close button (the opposite of hideClose); give the dialog its own Cancel or Close.</remarks>
    [Parameter] public bool ShowCloseButton { get; set; } = true;

    /// <inheritdoc />
    protected override void AddEventHandlers(Dictionary<string, object> handlers)
    {
        handlers["onpk-close"] = EventCallback.Factory.Create<PkCloseEventArgs>(this, HandlePkClose);
    }

    private async Task HandlePkClose(PkCloseEventArgs e)
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
        await OnClose.InvokeAsync(e);
    }
}
