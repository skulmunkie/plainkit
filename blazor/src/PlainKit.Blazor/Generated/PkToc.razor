@* Generated by scripts/generate-blazor.mjs from core/dist/elements/api.json and blazor/mappings/toc.json. Do not edit: change the mapping or the SDK and run it again. *@
@namespace PlainKit.Blazor
@using Microsoft.AspNetCore.Components.Web
@inherits PkElementBase

<pk-toc for="@For"
        levels="@Levels"
        offset="@PkAttr.Num(Offset)"
        scroller="@Scroller"
        heading="@Heading"
        label="@Label"
        class="@Css()"
        @attributes="Splat"></pk-toc>

@code {
    /// <summary>The element whose headings are listed.</summary>
    [Parameter] public string? For { get; set; } = "";

    /// <summary>Which headings to list.</summary>
    [Parameter] public string? Levels { get; set; } = "h2,h3";

    /// <summary>Distance from the top a heading must reach to count as current.</summary>
    [Parameter] public int Offset { get; set; } = 80;

    /// <summary>Scroll container (default: the window).</summary>
    [Parameter] public string? Scroller { get; set; } = "";

    /// <summary>The title setting</summary>
    [Parameter] public string? Heading { get; set; } = "";

    /// <summary>Accessible name</summary>
    [Parameter] public string? Label { get; set; } = "On this page";

    /// <summary>The current heading changed.</summary>
    [Parameter] public EventCallback<PkSectionChangeEventArgs> OnSectionChange { get; set; }

    /// <inheritdoc />
    protected override void AddEventHandlers(Dictionary<string, object> handlers)
    {
        handlers["onpk-section-change"] = EventCallback.Factory.Create<PkSectionChangeEventArgs>(this, HandlePkSectionChange);
    }

    private async Task HandlePkSectionChange(PkSectionChangeEventArgs e)
    {
        await OnSectionChange.InvokeAsync(e);
    }
}
