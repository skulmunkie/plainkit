@namespace PlainKit.Blazor
@using Microsoft.AspNetCore.Components.Web
@inherits PkElementBase

<pk-switch checked="@Checked"
           disabled="@Disabled"
           name="@Name"
           value="@Value"
           invalid="@IsInvalid"
           size="@Size"
           label-position="@LabelPosition"
           class="@Css()"
           @attributes="Splat">@ChildContent</pk-switch>

@code {
    /// <summary>Whether the switch is on.</summary>
    [Parameter] public bool Checked { get; set; }

    /// <summary>Raised with the new value of Checked (two-way: Checked follows it).</summary>
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }

    /// <summary>Blocks interaction; also set by a disabled fieldset.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>The form field name.</summary>
    [Parameter] public string? Name { get; set; }

    /// <summary>The value submitted while checked.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Shows the invalid state (a red ring) and sets aria-invalid.</summary>
    [Parameter] public bool IsInvalid { get; set; }

    /// <summary>Track size.</summary>
    [Parameter] public string? Size { get; set; }

    /// <summary>end puts the label after the switch, start before it, between pushes them to opposite edges of the row.</summary>
    [Parameter] public string? LabelPosition { get; set; }

    /// <summary>The label.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <inheritdoc />
    protected override void AddEventHandlers(Dictionary<string, object> handlers)
    {
        handlers["onpk-change"] = EventCallback.Factory.Create<PkChangeEventArgs>(this, HandlePkChange);
    }

    private async Task HandlePkChange(PkChangeEventArgs e)
    {
        Checked = e.Checked == true;
        await CheckedChanged.InvokeAsync(Checked);
    }
}
