@namespace PlainKit.Blazor
@using Microsoft.AspNetCore.Components.Web
@inherits PkElementBase

<pk-toolbar heading="@Heading"
            note="@Note"
            class="@Css()"
            @attributes="Splat">@ChildContent@if (ActionsContent is not null) {<span slot="actions">@ActionsContent</span>}</pk-toolbar>

@code {
    /// <summary>The lead title, in strong text.</summary>
    [Parameter] public string? Heading { get; set; }

    /// <summary>A muted note beside the title, such as a count.</summary>
    [Parameter] public string? Note { get; set; }

    /// <summary>More lead content after the title and note (filters, chips).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Buttons at the right; hidden when empty, full width and touch-sized on a narrow container.</summary>
    [Parameter] public RenderFragment? ActionsContent { get; set; }
}
