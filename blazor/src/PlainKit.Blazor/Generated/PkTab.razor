        Splat = new Dictionary<string, object>
        {
            ["onpk-tab-close"] = EventCallback.Factory.Create<PkTabCloseEventArgs>(this, HandlePkTabClose),
        };
    }

    private async Task HandlePkTabClose(PkTabCloseEventArgs e)
    {
        await OnClose.InvokeAsync(e);
    }
}
