@namespace PlainKit.Blazor
@using Microsoft.AspNetCore.Components.Web
@inherits PkElementBase

<pk-menu-item type="@(Type.ToAttr())"
              checked="@Checked"
              disabled="@Disabled"
              danger="@Danger"
              value="@Value"
              href="@Href"
              open="@Open"
              class="@Css()"
              @attributes="Splat">@ChildContent@if (PrefixContent is not null) {<span slot="prefix">@PrefixContent</span>}@if (SuffixContent is not null) {<span slot="suffix">@SuffixContent</span>}@if (SubmenuContent is not null) {<span slot="submenu">@SubmenuContent</span>}</pk-menu-item>

@code {
    /// <summary>What the row is.</summary>
    [Parameter] public MenuitemType Type { get; set; } = MenuitemType.Item;

    /// <summary>Checkbox and radio state.</summary>
    [Parameter] public bool Checked { get; set; }

    /// <summary>Raised when Checked changes (two-way binding: &lt;c&gt;@bind-Checked&lt;/c&gt;).</summary>
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }

    /// <summary>Skipped by keyboard, not activatable.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Destructive styling.</summary>
    [Parameter] public bool Danger { get; set; }

    /// <summary>Reported in pk-select; defaults to the label.</summary>
    [Parameter] public string? Value { get; set; } = "";

    /// <summary>Renders as a link.</summary>
    [Parameter] public string? Href { get; set; } = "";

    /// <summary>A submenu is open.</summary>
    [Parameter] public bool Open { get; set; }

    /// <summary>Label.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Icon before the label.</summary>
    [Parameter] public RenderFragment? PrefixContent { get; set; }

    /// <summary>Shortcut or badge after it.</summary>
    [Parameter] public RenderFragment? SuffixContent { get; set; }

    /// <summary>Nested pk-menu-item children.</summary>
    [Parameter] public RenderFragment? SubmenuContent { get; set; }

    /// <summary>Chosen (bubbles to the dropdown).</summary>
    [Parameter] public EventCallback<PkSelectEventArgs> OnSelect { get; set; }

    /// <inheritdoc />
    protected override void AddEventHandlers(Dictionary<string, object> handlers)
    {
        handlers["onpk-select"] = EventCallback.Factory.Create<PkSelectEventArgs>(this, HandlePkSelect);
    }

    private async Task HandlePkSelect(PkSelectEventArgs e)
    {
        Checked = e.Checked == true;
        await CheckedChanged.InvokeAsync(Checked);
        await OnSelect.InvokeAsync(e);
    }
}
