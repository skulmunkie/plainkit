@* Generated by scripts/generate-blazor.mjs from core/dist/elements/api.json and blazor/mappings/tooltip.json. Do not edit: change the mapping or the SDK and run it again. *@
@namespace PlainKit.Blazor
@using Microsoft.AspNetCore.Components.Web
@inherits PkElementBase

<pk-tooltip text="@Text"
            placement="@(Placement.ToAttr())"
            delay="@PkAttr.Num(HoverDelay)">@if (TooltipContent is not null) {<span slot="content">@TooltipContent</span>}@ChildContent</pk-tooltip>

@code {
    /// <summary>The label.</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>Rich tip content in place of text.</summary>
    [Parameter] public RenderFragment? TooltipContent { get; set; }

    /// <summary>The element the tip describes.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Preferred side; flips when it does not fit.</summary>
    [Parameter] public InfoTipPlacement Placement { get; set; } = InfoTipPlacement.Top;

    /// <summary>Mouse hover delay; focus is immediate.</summary>
    [Parameter] public int HoverDelay { get; set; } = 200;
}
