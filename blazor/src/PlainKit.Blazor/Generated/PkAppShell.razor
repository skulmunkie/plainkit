@namespace PlainKit.Blazor
@using Microsoft.AspNetCore.Components.Web
@inherits PkElementBase

<pk-app-shell nav-open="@NavOpen"
              flush="@Flush"
              class="@Css()"
              @attributes="Splat">@if (SidebarContent is not null) {<span slot="nav">@SidebarContent</span>}@if (HeaderContent is not null) {<span slot="header">@HeaderContent</span>}@BodyContent@if (FooterContent is not null) {<span slot="footer">@FooterContent</span>}</pk-app-shell>

@code {
    /// <summary>A pk-side-nav.</summary>
    [Parameter] public RenderFragment? SidebarContent { get; set; }

    /// <summary>Top bar content.</summary>
    [Parameter] public RenderFragment? HeaderContent { get; set; }

    /// <summary>The scrolling body.</summary>
    [Parameter] public RenderFragment? BodyContent { get; set; }

    /// <summary>Footer content.</summary>
    [Parameter] public RenderFragment? FooterContent { get; set; }

    /// <summary>Drawer state, mirrors the side nav.</summary>
    [Parameter] public bool NavOpen { get; set; }

    /// <summary>Raised when NavOpen changes (two-way binding: &lt;c&gt;@bind-NavOpen&lt;/c&gt;).</summary>
    [Parameter] public EventCallback<bool> NavOpenChanged { get; set; }

    /// <summary>Removes the body padding so a workspace, table or map sits edge to edge (the safe-area insets on a notched phone stay).</summary>
    [Parameter] public bool Flush { get; set; }

    /// <inheritdoc />
    protected override void AddEventHandlers(Dictionary<string, object> handlers)
    {
        handlers["onpk-nav-toggle"] = EventCallback.Factory.Create<PkNavToggleEventArgs>(this, HandlePkNavToggle);
    }

    private async Task HandlePkNavToggle(PkNavToggleEventArgs e)
    {
        NavOpen = e.Open == true;
        await NavOpenChanged.InvokeAsync(NavOpen);
    }
}
