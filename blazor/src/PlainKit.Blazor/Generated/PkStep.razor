@* Generated by scripts/generate-blazor.mjs from core/dist/elements/api.json and blazor/mappings/step.json. Do not edit: change the mapping or the SDK and run it again. *@
@namespace PlainKit.Blazor
@using Microsoft.AspNetCore.Components.Web
@inherits PkElementBase

<pk-step heading="@Heading"
         description="@Description"
         state="@(State.ToAttr())"
         index="@PkAttr.Num(Index)"
         disabled="@Disabled"
         last="@Last"
         clickable="@Clickable"
         orientation="@(Orientation.ToAttr())"
         class="@Css()"
         @attributes="Splat">@ChildContent@if (DescriptionContent is not null) {<span slot="description">@DescriptionContent</span>}</pk-step>

@code {
    /// <summary>The title setting</summary>
    [Parameter] public string? Heading { get; set; } = "";

    /// <summary>The description setting</summary>
    [Parameter] public string? Description { get; set; } = "";

    /// <summary>Set by the stepper.</summary>
    [Parameter] public StepState State { get; set; } = StepState.Todo;

    /// <summary>One-based, set by the stepper.</summary>
    [Parameter] public int Index { get; set; } = 0;

    /// <summary>Prevents interaction</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Set by the stepper: the last step draws no connector.</summary>
    [Parameter] public bool Last { get; set; }

    /// <summary>Set by the stepper: the step can be entered.</summary>
    [Parameter] public bool Clickable { get; set; }

    /// <summary>Set by the stepper.</summary>
    [Parameter] public StepOrientation Orientation { get; set; } = StepOrientation.Horizontal;

    /// <summary>Title (overrides the title prop).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Description.</summary>
    [Parameter] public RenderFragment? DescriptionContent { get; set; }
}
