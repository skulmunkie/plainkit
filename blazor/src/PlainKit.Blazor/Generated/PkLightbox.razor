@namespace PlainKit.Blazor
@using Microsoft.AspNetCore.Components.Web
@inherits PkElementBase

<pk-lightbox index="@PkAttr.Num(Index)"
             label="@Label"
             open="@Open"
             class="@Css()"
             @attributes="Splat">@ChildContent</pk-lightbox>

@code {
    /// <summary>The index setting</summary>
    [Parameter] public int Index { get; set; } = 0;

    /// <summary>Accessible name</summary>
    [Parameter] public string? Label { get; set; } = "Image viewer";

    /// <summary>Whether it is shown</summary>
    [Parameter] public bool Open { get; set; }

    /// <summary>Raised when Open changes (two-way binding: &lt;c&gt;@bind-Open&lt;/c&gt;).</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>The trigger.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Another image is shown.</summary>
    [Parameter] public EventCallback<PkChangeEventArgs> OnChange { get; set; }

    /// <summary>pk-close</summary>
    [Parameter] public EventCallback<PkCloseEventArgs> OnClose { get; set; }

    /// <inheritdoc />
    protected override void AddEventHandlers(Dictionary<string, object> handlers)
    {
        handlers["onpk-close"] = EventCallback.Factory.Create<PkCloseEventArgs>(this, HandlePkClose);
        handlers["onpk-change"] = EventCallback.Factory.Create<PkChangeEventArgs>(this, HandlePkChange);
    }

    private async Task HandlePkClose(PkCloseEventArgs e)
    {
        Open = false;
        await OpenChanged.InvokeAsync(Open);
        await OnClose.InvokeAsync(e);
    }

    private async Task HandlePkChange(PkChangeEventArgs e)
    {
        await OnChange.InvokeAsync(e);
    }
}
