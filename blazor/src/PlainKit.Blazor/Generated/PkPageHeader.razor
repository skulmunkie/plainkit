@* Generated by scripts/generate-blazor.mjs from core/dist/elements/api.json and blazor/mappings/page-header.json. Do not edit: change the mapping or the SDK and run it again. *@
@namespace PlainKit.Blazor
@using Microsoft.AspNetCore.Components.Web
@inherits PkElementBase

<pk-page-header heading="@Heading"
                level="@PkAttr.Num(Level)"
                variant="@Variant"
                class="@Css()"
                @attributes="Splat">@ChildContent@if (BreadcrumbContent is not null) {<span slot="breadcrumb">@BreadcrumbContent</span>}@if (ActionsContent is not null) {<span slot="actions">@ActionsContent</span>}@if (MetaContent is not null) {<span slot="meta">@MetaContent</span>}</pk-page-header>

@code {
    /// <summary>The title. Without it (and without default or actions content) the title bar is not shown.</summary>
    [Parameter] public string? Heading { get; set; }

    /// <summary>The heading level the title exposes to assistive technology (aria-level).</summary>
    [Parameter] public int Level { get; set; } = 2;

    /// <summary>page is the standard page top; section is a titled section inside a page (title, actions, note); record is the compact strip of a single-record page (chips on the left, actions right).</summary>
    [Parameter] public string? Variant { get; set; }

    /// <summary>Beside the title: status chips, badges or your own heading element.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>A pk-breadcrumb (or any trail) above the title; hidden when empty.</summary>
    [Parameter] public RenderFragment? BreadcrumbContent { get; set; }

    /// <summary>Buttons at the right of the title bar; full width and touch-sized on a narrow container.</summary>
    [Parameter] public RenderFragment? ActionsContent { get; set; }

    /// <summary>A note or metadata line under the title bar; hidden when empty.</summary>
    [Parameter] public RenderFragment? MetaContent { get; set; }
}
