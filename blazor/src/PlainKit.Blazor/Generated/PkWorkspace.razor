@* Generated by scripts/generate-blazor.mjs from core/dist/elements/api.json and blazor/mappings/workspace.json. Do not edit: change the mapping or the SDK and run it again. *@
@namespace PlainKit.Blazor
@using Microsoft.AspNetCore.Components.Web
@inherits PkElementBase

<pk-workspace fill="@Fill"
              active-pane="@ActivePane"
              aside-open="@AsideOpen"
              nav-label="@NavLabel"
              main-label="@MainLabel"
              aside-label="@AsideLabel"
              @attributes="Splat">@if (NavContent is not null) {<span slot="nav">@NavContent</span>}@ChildContent@if (AsideContent is not null) {<span slot="aside">@AsideContent</span>}</pk-workspace>

@code {
    /// <summary>Fill the height the parent gives it (a parent with a definite height, or a flex or grid parent) and drop the frame, for a tool that owns the whole page. Without it the workspace is as tall as the viewport minus a reserve.</summary>
    [Parameter] public bool Fill { get; set; }

    /// <summary>The pane shown on a phone. On a wider screen every pane shows. A pane that does not exist falls back to the main pane.</summary>
    [Parameter] public string? ActivePane { get; set; } = "main";

    /// <summary>Raised when ActivePane changes (two-way binding: &lt;c&gt;@bind-ActivePane&lt;/c&gt;).</summary>
    [Parameter] public EventCallback<string?> ActivePaneChanged { get; set; }

    /// <summary>Show the aside: a docked column on a wide screen, a panel over the main pane on a tablet and its own pane on a phone.</summary>
    [Parameter] public bool AsideOpen { get; set; }

    /// <summary>The nav pane's accessible name and its tab on a phone.</summary>
    [Parameter] public string? NavLabel { get; set; } = "Contents";

    /// <summary>The main pane's accessible name and its tab on a phone.</summary>
    [Parameter] public string? MainLabel { get; set; } = "Content";

    /// <summary>The aside's accessible name and its tab on a phone.</summary>
    [Parameter] public string? AsideLabel { get; set; } = "Details";

    /// <summary>The nav pane: a file tree, a list of sections, filters. Leave it out for a two-pane workspace.</summary>
    [Parameter] public RenderFragment? NavContent { get; set; }

    /// <summary>The main pane.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The docked aside (an inspector or a details panel). It shows when asideOpen is set.</summary>
    [Parameter] public RenderFragment? AsideContent { get; set; }

    /// <summary>A tab in the phone strip was chosen. Cancelable: preventDefault keeps the previous pane.</summary>
    [Parameter] public EventCallback<PkPaneChangeEventArgs> OnPaneChange { get; set; }

    private Dictionary<string, object> Splat { get; set; } = new();

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        Splat = new Dictionary<string, object>
        {
            ["onpk-pane-change"] = EventCallback.Factory.Create<PkPaneChangeEventArgs>(this, HandlePkPaneChange),
        };
    }

    private async Task HandlePkPaneChange(PkPaneChangeEventArgs e)
    {
        ActivePane = e.Pane;
        await ActivePaneChanged.InvokeAsync(ActivePane);
        await OnPaneChange.InvokeAsync(e);
    }
}
