@namespace PlainKit.Blazor
@using Microsoft.AspNetCore.Components.Web
@inherits PkElementBase

<pk-accordion-item heading="@Heading"
                   open="@Open"
                   class="@Css()"
                   @attributes="Splat">@ChildContent@if (HeadingContent is not null) {<span slot="heading">@HeadingContent</span>}@if (IconContent is not null) {<span slot="icon">@IconContent</span>}</pk-accordion-item>

@code {
    /// <summary>Header text.</summary>
    [Parameter] public string? Heading { get; set; }

    /// <summary>Expanded.</summary>
    [Parameter] public bool Open { get; set; }

    /// <summary>Raised with the new value of Open (two-way: Open follows it).</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>The panel.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>A rich heading; overrides heading.</summary>
    [Parameter] public RenderFragment? HeadingContent { get; set; }

