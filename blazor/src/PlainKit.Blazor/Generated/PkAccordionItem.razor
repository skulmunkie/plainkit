    [Parameter] public RenderFragment? IconContent { get; set; }

    /// <inheritdoc />
    protected override void AddEventHandlers(Dictionary<string, object> handlers)
    {
        handlers["onpk-toggle"] = EventCallback.Factory.Create<PkToggleEventArgs>(this, HandlePkToggle);
    }

    private async Task HandlePkToggle(PkToggleEventArgs e)
    {
        Open = e.Open == true;
        await OpenChanged.InvokeAsync(Open);
    }
}
