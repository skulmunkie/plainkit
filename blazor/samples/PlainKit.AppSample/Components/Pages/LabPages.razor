@page "/lab/pages"
@using System.Text.Json

@* Lab (the harness's paths, scripts/blazor-browser-lab-cases.mjs): the callback properties of the page types (Run, Save, Load) and a JSON attribute (Config, Values) changed after the first render. *@
<h1 tabindex="-1">Pages</h1>
<PkButton OnClick="Rename">Rename</PkButton>
<p id="lab-log">Log: @_log</p>
<PkToolPage Config="@ToolConfig" RunLabel="Go" Run="RunTool" />
<PkSettingsPage Config="@SettingsConfig" Values="@_values" Save="SaveSettings" SectionContent="_sectionContent" />
<PkDashboardPage Config="@DashConfig" Load="LoadWidget" />

@code {
    private const string ToolConfig = """{"input":[{"key":"name","type":"text","label":"Name"}],"outcome":"text"}""";
    private const string DashConfig = """{"widgets":[{"key":"ok","label":"Fine widget","kind":"stat"},{"key":"bad","label":"Broken widget","kind":"stat"}]}""";
    private string _values = """{"nick":"first"}""";
    private string _log = "";
    private readonly Dictionary<string, RenderFragment> _sectionContent = new() { ["profile"] = b => b.AddMarkupContent(0, "<p id=\"lab-section-profile\">Custom profile content</p>"), ["notifications"] = b => b.AddMarkupContent(0, "<pk-card heading=\"Email\" id=\"lab-bare-a\"><p>Own card A</p></pk-card><pk-card heading=\"Push\" id=\"lab-bare-b\"><p>Own card B</p></pk-card>") };

    // Config follows a C# field: Rename changes the label of the field after the first render.
    private string _label = "Nickname";
    private string SettingsConfig => JsonSerializer.Serialize(new { sections = new object[] { new { key = "profile", heading = "Profile", bare = false, fields = new[] { new { key = "nick", type = "text", label = _label } } }, new { key = "notifications", heading = "Notifications", bare = true, fields = Array.Empty<object>() }, new { key = "billing", heading = "Billing", bare = false, fields = new[] { new { key = "tax", type = "text", label = "Tax number" } } } } });

    private void Rename() { _label = "Handle"; _values = """{"nick":"second"}"""; }
    private Task<object?> RunTool(IReadOnlyDictionary<string, JsonElement> v) => Task.FromResult<object?>("Hello " + v["name"].GetString());
    private async Task SaveSettings(IReadOnlyDictionary<string, JsonElement> v)
    {
        var nick = v["nick"].GetString();
        if (nick == "FAIL") throw new PlainKit.AppSample.Modules.SampleUserFacingException("Save refused by the sample");
        if (nick == "BOOM") throw new InvalidOperationException(@"Boom at C:uild\Secret.cs:line 7");
        _log = "saved " + nick;
        await InvokeAsync(StateHasChanged); // a bridge callback is not a UI event: nothing re-renders for it
    }
    private Task<object?> LoadWidget(string key) => key == "ok" ? Task.FromResult<object?>(new { value = "42", subtext = "answered" }) : throw new InvalidOperationException("Widget refused by the sample");
}
