@* The whole frame: PkApp draws the chrome from the module catalog, PkModuleBoundary keeps a failing page (or a failed module download) from taking the frame down, PkRouteGuard is the UX guard.
   AuthorizeRouteView is what makes [Authorize] pages (/secure/audit) real. *@
<PkApp>
    <PkModuleBoundary>
        <PkRouteGuard>
            <Router AppAssembly="typeof(Program).Assembly">
                <Found Context="routeData">
                    <AuthorizeRouteView RouteData="routeData">
                        <NotAuthorized><PkNotFoundPage Heading="Not allowed" Description="Sign in to see this page." /></NotAuthorized>
                    </AuthorizeRouteView>
                </Found>
                <NotFound><PkNotFoundPage /></NotFound>
            </Router>
        </PkRouteGuard>
    </PkModuleBoundary>
</PkApp>
