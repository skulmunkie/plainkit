@page "/page-checks"

@* Checked in a live browser: a Size="Lg" dialog opens wide, PkStyles' link is the first stylesheet in the head, PkPageHeader renders its title and breadcrumb. *@
<div style="padding:1rem;display:grid;gap:1rem;max-width:60rem">
    <PkPageHeader id="header" Crumbs="_crumbs" Title="Acme Supply order">
        <SuffixContent><PkBadge>Open</PkBadge></SuffixContent>
        <ActionsContent><PkButton>Receive</PkButton></ActionsContent>
    </PkPageHeader>

    <PkButton id="open-lg" OnClick="@(() => _open = true)">Open a large dialog</PkButton>
    <PkDialog id="dlg" @bind-IsOpen="_open" Title="Review proposals" Size="PkDialogSize.Lg">
        <ChildContent><p>A wide dialog.</p></ChildContent>
        <FooterContent><PkButton OnClick="@(() => _open = false)">Close</PkButton></FooterContent>
    </PkDialog>
</div>

@code {
    private bool _open;
    private readonly PkCrumb[] _crumbs = [new("Stock", "/stock"), new("Purchase orders", "/stock/orders"), new("PO 1042")];
}
