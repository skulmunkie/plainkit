@page "/routed/orders"

@* The list half of the routed pair (guide "A routed list and record page"): RowHrefTemplate links each row to the record page. *@
<PkListPage TItem="Order"
            Config="@_config"
            Columns="_columns"
            Load="RoutedOrderStore.PageAsync"
            IdOf="o => o.Id"
            RowHrefTemplate="/routed/orders/{id}" />

@code {
    private const string _config = """{"label":"Orders","pageSize":10}""";

    private static readonly PkTableColumn<Order>[] _columns =
    [
        new() { Key = "orderNo", Label = "Order", Sortable = true },
        new() { Key = "customer", Label = "Customer", Cell = o => @<strong>@o.Customer</strong> },
    ];
}
