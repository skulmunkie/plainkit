@page "/routed/orders/{Id}"
@inherits PageBase
@inject NavigationManager Nav

@* The record half of the routed pair: the route gives the id, Config carries it, Load, Save and OnDelete are your data access. Busy and Error bind the page's own state (PageBase.IsBusy and StatusMessage), so a failed delete shows above the record. *@
<PkRecordPage Config="@Config" Load="RoutedOrderStore.GetAsync" Save="SaveAsync" OnDelete="DeleteAsync" Busy="IsBusy" Error="StatusMessage" />

@code {
    [Parameter] public string Id { get; set; } = "";

    private string Config => System.Text.Json.JsonSerializer.Serialize(new
    {
        id = Id,
        heading = "Order",
        fields = new object[] { new { name = "customer", label = "Customer", required = true }, new { name = "note", label = "Note", type = "textarea" } },
    });

    private Task SaveAsync(IReadOnlyDictionary<string, System.Text.Json.JsonElement> values) =>
        RoutedOrderStore.SaveAsync(Id, values["customer"].GetString() ?? "", values["note"].GetString() ?? "");

    private async Task DeleteAsync()
    {
        ClearStatus();
        if (await TryBusyAsync(() => RoutedOrderStore.DeleteAsync(Id), "Deleting")) Nav.NavigateTo("/routed/orders");
    }
}
