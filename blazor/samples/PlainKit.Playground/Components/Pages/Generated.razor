@page "/generated"
@inject IPkLog PkLog

@* A small page that exercises the generated components in a real browser: two-way binds, a dialog driven from C#, a click, a pk-* event
   with a detail, an enum parameter and IPkLog writes. Each thing shows its state in an element with an id so a script can check it. *@
<div style="padding:1rem;display:grid;gap:1rem;max-width:44rem">
    <h1>Generated components</h1>

    <PkInput @bind-Value="_text" Placeholder="Type here" AriaLabel="Text" />
    <p>Input value in C#: <code id="out-text">@_text</code></p>
    <PkButton OnClick="@(() => _text = "set from C#")">Set input from C#</PkButton>

    <PkCheckbox @bind-Checked="_checked">Check me</PkCheckbox>
    <p>Checkbox in C#: <code id="out-checked">@_checked</code></p>
    <PkButton OnClick="@(() => _checked = !_checked)">Toggle checkbox from C#</PkButton>

    <div>
        <PkButton Variant="ButtonVariant.Primary" OnClick="OnClick">Primary click</PkButton>
        <PkButton Variant="ButtonVariant.Warn" OnClick="OnClick">Warn click</PkButton>
    </div>
    <PkButton Variant="_variant" Size="ButtonSize.Lg" OnClick="CycleVariant">Cycle variant (<span id="out-variant">@_variant</span>)</PkButton>
    <p>Clicks: <code id="out-clicks">@_clicks</code></p>

    <PkInput Type="search" Placeholder="Search" AriaLabel="Search" OnSearch="OnSearch" />
    <p>Last search: <code id="out-search">@_search</code></p>

    <PkButton OnClick="@(() => _open = true)">Open dialog</PkButton>
    <PkDialog @bind-IsOpen="_open" Title="A dialog" OnClose="OnClose">
        <ChildContent><p>Dialog body</p></ChildContent>
        <FooterContent><PkButton OnClick="@(() => _open = false)">Close from C#</PkButton></FooterContent>
    </PkDialog>
    <p>Dialog open in C#: <code id="out-open">@_open</code> (close events: <code id="out-closes">@_closes</code>)</p>

    @* Unmatched attributes (id, data-*, aria-*, class) go on the element; the hand-written PkCard, PkEmptyState, PkFieldList and PkStat. *@
    <PkButton id="pass-button" data-test="y" aria-label="Passthrough" class="mine" Variant="ButtonVariant.Secondary">Passthrough</PkButton>
    <PkAlert id="pass-alert" ExtraClass="extra" class="mine" Kind="PkAlertKind.Info" Boxed="false" Compact="true">A plain, compact alert</PkAlert>

    <PkCard id="card" Heading="A card" Level="3">
        <ChildContent>Card body</ChildContent>
        <ActionsContent><PkButton>Edit</PkButton></ActionsContent>
        <FooterContent>Card footer</FooterContent>
    </PkCard>
    <PkStat id="stat" Label="Revenue" Value="$1.2k" Delta="4.5" Tone="PkStatTone.Positive" Series="@(new double[] { 1, 3, 2, 5 })" Interactive="true" OnClick="OnStat" />
    <p>Stat clicks: <code id="out-stat">@_stats</code></p>
    <PkFieldList id="fields" Title="Details" Dividers="true">
        <dt>Name</dt><dd>Ada</dd>
        <dt>Role</dt><dd>Engineer</dd>
    </PkFieldList>
    <PkEmptyState id="empty" Title="Nothing here" Description="Add the first item">
        <ActionContent><PkButton Variant="ButtonVariant.Primary">Add</PkButton></ActionContent>
    </PkEmptyState>

    @* Typed JSON parameters (issue #77): the record is serialised into the data / images attribute and the element draws it. *@
    <PkChart id="chart" Kind="bar" Data="_chart" />
    <PkImageGallery id="gallery" Images="_images" />

    <PkButton OnClick="WriteLogs">Write logs with IPkLog</PkButton>
    <pk-nope></pk-nope>

    <PkLogs Height="20rem" />
    <PkLogSettings Height="26rem" />
</div>

@code {
    private string? _text = "start";
    private bool _checked;
    private bool _open;
    private int _clicks;
    private int _closes;
    private string _search = "";
    private readonly PkChartData _chart = new() { Labels = ["Mon", "Tue", "Wed"], Series = [new PkChartSeries { Name = "Visits", Values = [3, 5.5, 4] }] };
    private readonly IReadOnlyList<PkGalleryImage> _images = [new() { Src = "/a.png", Alt = "First", Primary = true }, new() { Src = "/b.png", Alt = "Second", Status = "Staged" }];

    // Runs once while prerendering (where JavaScript is not available: the call is dropped without throwing) and once on the circuit (where it is written).
    protected override async Task OnInitializedAsync() =>
        await PkLog.WriteAsync(PkLogLevel.Info, "playground", "page initialised");

    private ButtonVariant _variant = ButtonVariant.Warn;
    private void CycleVariant() => _variant = _variant == ButtonVariant.Warn ? ButtonVariant.Primary : ButtonVariant.Warn;

    private void OnClick() => _clicks++;
    private void OnSearch(PkSearchEventArgs e) => _search = e.Value ?? "(null)";
    private void OnClose() => _closes++;
    private int _stats;
    private void OnStat() => _stats++;

    private async Task WriteLogs()
    {
        await PkLog.WriteAsync(PkLogLevel.Warn, "playground", "warn from IPkLog", "detail-1");
        await PkLog.WriteAsync(PkLogLevel.Error, "playground", "error from IPkLog");
    }
}
