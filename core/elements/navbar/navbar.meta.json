{
  "tag": "pk-navbar",
  "title": "Navbar",
  "summary": "The top navigation: brand, links, dropdown and mega menus, right-aligned actions, sticky option, and a hamburger that folds the links below 1024px.",
  "group": "Navigation",
  "props": [
    {
      "name": "label",
      "type": "string",
      "default": "Main",
      "reflect": true,
      "description": "Accessible name"
    },
    {
      "name": "open",
      "type": "boolean",
      "default": false,
      "reflect": true,
      "description": "Links unfolded (small screens)."
    },
    {
      "name": "sticky",
      "type": "boolean",
      "default": false,
      "reflect": true,
      "description": "The sticky setting"
    }
  ],
  "slots": [
    {
      "name": "brand",
      "description": "Brand link."
    },
    {
      "name": "",
      "description": "Links and pk-dropdown menus."
    },
    {
      "name": "actions",
      "description": "Right-aligned controls."
    }
  ],
  "events": [
    {
      "name": "pk-toggle",
      "detail": {
        "open": "boolean"
      },
      "description": "Hamburger toggled."
    }
  ],
  "parts": [
    {
      "name": "nav",
      "description": "The nav landmark"
    },
    {
      "name": "brand",
      "description": "Brand area"
    },
    {
      "name": "toggle",
      "description": "Hamburger button"
    },
    {
      "name": "bars",
      "description": "Hamburger bars"
    },
    {
      "name": "links",
      "description": "Link group"
    },
    {
      "name": "actions",
      "description": "Action buttons"
    }
  ],
  "cssProperties": [],
  "methods": [],
  "a11y": "A nav landmark; the hamburger is a button with aria-expanded controlling the links; the current link has aria-current=\"page\".",
  "mobile": "Links fold behind a 44px hamburger and stack full width; dropdown menus open inline.",
  "blazor": {
    "component": "Navbar",
    "params": [
      {
        "name": "Label",
        "type": "string",
        "default": "Main",
        "map": "prop",
        "prop": "label"
      },
      {
        "name": "Open",
        "type": "bool",
        "default": false,
        "map": "prop",
        "prop": "open"
      },
      {
        "name": "Sticky",
        "type": "bool",
        "default": false,
        "map": "prop",
        "prop": "sticky"
      },
      {
        "name": "BrandContent",
        "type": "RenderFragment?",
        "map": "slot",
        "slot": "brand"
      },
      {
        "name": "ChildContent",
        "type": "RenderFragment?",
        "map": "slot",
        "slot": ""
      },
      {
        "name": "ActionsContent",
        "type": "RenderFragment?",
        "map": "slot",
        "slot": "actions"
      },
      {
        "name": "OnToggle",
        "type": "EventCallback<NavbarToggleEventArgs>",
        "map": "event",
        "event": "pk-toggle"
      }
    ]
  },
  "examples": [
    {
      "title": "Navbar with a menu and actions",
      "html": "<pk-navbar label=\"Main\"><a slot=\"brand\" href=\"#\">Brand</a><a href=\"#\" aria-current=\"page\">Dashboard</a><a href=\"#\">Orders</a><pk-dropdown><button type=\"button\" slot=\"trigger\" class=\"btn-ghost\">More</button><pk-menu-item href=\"#\">Customers</pk-menu-item><pk-menu-item href=\"#\">Reports</pk-menu-item></pk-dropdown><button type=\"button\" slot=\"actions\" class=\"btn-mini btn-ghost\">Account</button></pk-navbar>"
    },
    {
      "title": "Navbar with a mega menu",
      "html": "<pk-navbar label=\"Main\"><a slot=\"brand\" href=\"#\">Brand</a><pk-dropdown mega><button type=\"button\" slot=\"trigger\" class=\"btn-ghost\">Products</button><pk-menu-item type=\"header\">Catalog</pk-menu-item><pk-menu-item href=\"#\">All products</pk-menu-item><pk-menu-item href=\"#\">Drafts</pk-menu-item><pk-menu-item type=\"header\">Stock</pk-menu-item><pk-menu-item href=\"#\">Receiving</pk-menu-item><pk-menu-item href=\"#\">Adjustments</pk-menu-item></pk-dropdown><a href=\"#\">Orders</a></pk-navbar>"
    }
  ]
}
