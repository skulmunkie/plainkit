{
  "comment": "Shared by js/page-lifecycle.js and the C# lifecycle (#1022, design section 3.1). Each case is scripted events on a fresh lifecycle with a page that counts busy and status errors. load/run name a deferred 'id'; resolve/reject settle it; 'abort' fires the lifecycle's external signal. 'states' is life.state after each step. 'applied' lists load results delivered (id, value), 'rejected' load errors delivered, 'aborted' the ids whose signal was aborted, 'runs' the run outcomes (id, 'ok:value' | 'err:value'), 'pageErrors' the number of page status errors set, 'busy' the page's busy count at the end.",
  "cases": [
    { "name": "load reports loading before any await, then ready", "steps": [ {"op":"load","id":"a"}, {"op":"resolve","id":"a","value":1} ], "expect": { "states": ["loading","ready"], "applied": [["a",1]], "rejected": [], "aborted": [], "runs": [], "pageErrors": 0, "busy": 0 } },
    { "name": "a superseded load is aborted and its result never applied", "steps": [ {"op":"load","id":"a"}, {"op":"load","id":"b"}, {"op":"resolve","id":"a","value":1}, {"op":"resolve","id":"b","value":2} ], "expect": { "states": ["loading","loading","loading","ready"], "applied": [["b",2]], "rejected": [], "aborted": ["a"], "runs": [], "pageErrors": 0, "busy": 0 } },
    { "name": "a superseded load error is dropped, the current error is delivered once", "steps": [ {"op":"load","id":"a"}, {"op":"load","id":"b"}, {"op":"reject","id":"a","value":"x"}, {"op":"reject","id":"b","value":"y"} ], "expect": { "states": ["loading","loading","loading","error"], "applied": [], "rejected": [["b","y"]], "aborted": ["a"], "runs": [], "pageErrors": 1, "busy": 0 } },
    { "name": "an aborted load is not an error", "steps": [ {"op":"load","id":"a"}, {"op":"abort"}, {"op":"reject","id":"a","value":"AbortError"} ], "expect": { "states": ["loading","idle","idle"], "applied": [], "rejected": [], "aborted": ["a"], "runs": [], "pageErrors": 0, "busy": 0 } },
    { "name": "destroy aborts, drops the result and is idempotent", "steps": [ {"op":"load","id":"a"}, {"op":"destroy"}, {"op":"destroy"}, {"op":"resolve","id":"a","value":1}, {"op":"load","id":"b"} ], "expect": { "states": ["loading","idle","idle","idle","idle"], "applied": [], "rejected": [], "aborted": ["a"], "runs": [], "pageErrors": 0, "busy": 0 } },
    { "name": "refresh re-runs the last load and supersedes the one in flight", "steps": [ {"op":"load","id":"a"}, {"op":"refresh","id":"b"}, {"op":"resolve","id":"a","value":1}, {"op":"resolve","id":"b","value":2} ], "expect": { "states": ["loading","loading","loading","ready"], "applied": [["b",2]], "rejected": [], "aborted": ["a"], "runs": [], "pageErrors": 0, "busy": 0 } },
    { "name": "refresh after destroy is a no-op", "steps": [ {"op":"load","id":"a"}, {"op":"destroy"}, {"op":"refresh","id":"b"} ], "expect": { "states": ["loading","idle","idle"], "applied": [], "rejected": [], "aborted": ["a"], "runs": [], "pageErrors": 0, "busy": 0 } },
    { "name": "run is counted busy and succeeds", "steps": [ {"op":"run","id":"a","label":"save"}, {"op":"resolve","id":"a","value":1} ], "expect": { "states": ["idle","idle"], "applied": [], "rejected": [], "aborted": [], "runs": [["a","ok:1"]], "pageErrors": 0, "busy": 0 } },
    { "name": "run rejects to its caller and sets the page status once", "steps": [ {"op":"run","id":"a","label":"save"}, {"op":"reject","id":"a","value":"boom"} ], "expect": { "states": ["idle","idle"], "applied": [], "rejected": [], "aborted": [], "runs": [["a","err:boom"]], "pageErrors": 1, "busy": 0 } },
    { "name": "a run aborted by destroy is neither an error nor a status", "steps": [ {"op":"run","id":"a","label":"save"}, {"op":"destroy"}, {"op":"reject","id":"a","value":"AbortError"} ], "expect": { "states": ["idle","idle","idle"], "applied": [], "rejected": [], "aborted": [], "runs": [["a","ok:undefined"]], "pageErrors": 0, "busy": 0 } },
    { "name": "run after destroy does nothing", "steps": [ {"op":"destroy"}, {"op":"run","id":"a","label":"save"} ], "expect": { "states": ["idle","idle"], "applied": [], "rejected": [], "aborted": [], "runs": [["a","ok:undefined"]], "pageErrors": 0, "busy": 0 } }
  ]
}
