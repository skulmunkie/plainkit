{
  "tag": "pk-app-frame",
  "title": "App frame",
  "summary": "The app frame from data: header (brand, module picker, search, settings), side nav, breadcrumbs, page and footer. It routes nothing; the host navigates.",
  "group": "Layout & structure",
  "tier": "shell",
  "props": [
    {
      "name": "brand",
      "type": "string",
      "default": "",
      "reflect": false,
      "description": "The brand text in the header."
    },
    {
      "name": "brandHref",
      "type": "string",
      "default": "",
      "reflect": false,
      "description": "Where the brand links (same-site path or http(s)); empty is plain text."
    },
    {
      "name": "navLabel",
      "type": "string",
      "default": "Main",
      "reflect": false,
      "description": "The side nav landmark name."
    },
    {
      "name": "nav",
      "type": "json",
      "default": [],
      "reflect": false,
      "description": "Side nav rows: { id, title, href?, icon?, badge?, children? }[]. Empty draws no nav."
    },
    {
      "name": "currentId",
      "type": "string",
      "default": "",
      "reflect": false,
      "description": "Id of the current row."
    },
    {
      "name": "trail",
      "type": "json",
      "default": [],
      "reflect": false,
      "description": "Ids of the branches to open (ancestors of the current row)."
    },
    {
      "name": "modules",
      "type": "json",
      "default": [],
      "reflect": false,
      "description": "The module picker: { id, title, href }[]; fewer than two draws none. On a phone it is the first row of the drawer."
    },
    {
      "name": "moduleTitle",
      "type": "string",
      "default": "",
      "reflect": false,
      "description": "The active module, shown on the picker."
    },
    {
      "name": "crumbs",
      "type": "json",
      "default": [],
      "reflect": false,
      "description": "Breadcrumbs: { label, href? }[]; the last is the current page. Empty draws none."
    },
    {
      "name": "search",
      "type": "boolean",
      "default": false,
      "reflect": false,
      "description": "Shows the header search."
    },
    {
      "name": "searchPlaceholder",
      "type": "string",
      "default": "Search",
      "reflect": false,
      "description": "The search field placeholder and name."
    },
    {
      "name": "busy",
      "type": "boolean",
      "default": false,
      "reflect": false,
      "description": "Blocks the page behind a loading overlay."
    },
    {
      "name": "busyLabel",
      "type": "string",
      "default": "",
      "reflect": false,
      "description": "Its label."
    },
    {
      "name": "searchItems",
      "type": "json",
      "default": [],
      "reflect": false,
      "description": "Search results, pk-app-bar-search items; the host sets them on pk-query."
    }
  ],
  "slots": [
    {
      "name": "",
      "description": "The page, with the skip link target (main#pk-main)."
    },
    {
      "name": "footer",
      "description": "Footer content."
    }
  ],
  "events": [
    {
      "name": "pk-query",
      "detail": {
        "query": "string"
      },
      "description": "The search text changed; set searchItems."
    },
    {
      "name": "pk-select",
      "detail": {
        "item": "object"
      },
      "description": "A search result was chosen."
    },
    {
      "name": "pk-theme-toggle",
      "detail": {},
      "description": "Toggle theme was chosen."
    }
  ],
  "parts": [
    {
      "name": "shell",
      "description": "The pk-app-shell"
    },
    {
      "name": "nav",
      "description": "The side nav"
    },
    {
      "name": "bar",
      "description": "The header bar"
    },
    {
      "name": "brand",
      "description": "The brand link"
    },
    {
      "name": "picker",
      "description": "The module picker"
    },
    {
      "name": "search",
      "description": "The header search"
    },
    {
      "name": "settings",
      "description": "The settings menu"
    },
    {
      "name": "crumbs",
      "description": "The breadcrumb"
    },
    {
      "name": "module",
      "description": "The active module title"
    },
    {
      "name": "theme",
      "description": "The Toggle theme item"
    },
    {
      "name": "footer",
      "description": "The footer strip content"
    }
  ],
  "cssProperties": [],
  "methods": [],
  "writes": [],
  "a11y": "Landmarks, keyboard and focus come from pk-app-shell, pk-navbar, pk-side-nav and pk-breadcrumb. The skip link and main landmark belong to the page slot (an id cannot cross the shadow boundary).",
  "mobile": "The side nav is a drawer; the search collapses to an icon.",
  "examples": [
    {
      "title": "App frame with a module picker",
      "html": "<pk-app-frame brand=\"Acme\" brand-href=\"#\" module-title=\"Sales\" current-id=\"open\" nav='[{\"id\":\"home\",\"title\":\"Home\",\"href\":\"#home\",\"icon\":\"home\"},{\"id\":\"orders\",\"title\":\"Orders\",\"href\":\"#orders\",\"badge\":3,\"children\":[{\"id\":\"open\",\"title\":\"Open\",\"href\":\"#open\"},{\"id\":\"shipped\",\"title\":\"Shipped\",\"href\":\"#shipped\"}]},{\"id\":\"reports\",\"title\":\"Reports\",\"href\":\"#reports\"}]' trail='[\"orders\",\"open\"]' modules='[{\"id\":\"sales\",\"title\":\"Sales\",\"href\":\"#sales\"},{\"id\":\"support\",\"title\":\"Support\",\"href\":\"#support\"}]' crumbs='[{\"label\":\"Sales\",\"href\":\"#sales\"},{\"label\":\"Orders\",\"href\":\"#orders\"},{\"label\":\"Open\"}]' search search-placeholder=\"Search orders\"><pk-page-header heading=\"Open orders\"></pk-page-header><p>The page goes in the default slot.</p><span slot=\"footer\">Acme 2026</span></pk-app-frame>"
    },
    {
      "title": "One module, no search",
      "html": "<pk-app-frame brand=\"Acme\" nav='[{\"id\":\"home\",\"title\":\"Home\",\"href\":\"#home\",\"icon\":\"home\"},{\"id\":\"orders\",\"title\":\"Orders\",\"href\":\"#orders\",\"badge\":3,\"children\":[{\"id\":\"open\",\"title\":\"Open\",\"href\":\"#open\"},{\"id\":\"shipped\",\"title\":\"Shipped\",\"href\":\"#shipped\"}]},{\"id\":\"reports\",\"title\":\"Reports\",\"href\":\"#reports\"}]' current-id=\"home\"><pk-page-header heading=\"Home\"></pk-page-header></pk-app-frame>"
    }
  ]
}
